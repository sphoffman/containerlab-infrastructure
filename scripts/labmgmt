class LabMgmtError(Exception):
    pass


def load_yaml(path):
    if not path.exists():
        raise LabMgmtError(f"File not found: {path}")

    try:
        with path.open("r") as f:
            data = yaml.safe_load(f)
    except yaml.YAMLError as exc:
        raise LabMgmtError(f"Invalid YAML in {path}:\n{exc}")

    if data is None:
        data = {}

    return data

def write_yaml_atomic(path, data):
    temp_path = path.with_name(f".{path.name}.tmp-{os.getpid()}")

    try:
        with temp_path.open("w") as f:
            yaml.safe_dump(
                data,
                f,
                sort_keys=False,
                default_flow_style=False,
            )
            f.flush()
            os.fsync(f.fileno())

        os.replace(temp_path, path)

    except OSError as exc:
        try:
            temp_path.unlink(missing_ok=True)
        except OSError:
            pass

        raise LabMgmtError(
            f"Unable to write {path}: {exc}"
        )


def repo_relative(path):
    try:
        return path.resolve().relative_to(REPO_ROOT).as_posix()
    except ValueError:
        raise LabMgmtError(
            f"Topology must be inside {REPO_ROOT}: {path}"
        )

def normalize_mgmt_ipv4(value):
    if value is None:
        return None

    value = str(value).strip()

    try:
        if "/" in value:
            return str(ipaddress.ip_interface(value).ip)

        return str(ipaddress.ip_address(value))

    except ValueError:
        return None

def plan_new_node_addresses(config, lab_data, count):
    if count == 0:
        return [], None, None

    subnet = ipaddress.ip_network(lab_data["lab"]["subnet"])

    allocation = lab_data["allocation"]

    next_node = int(allocation["next_node_address"])

    last_node = int(
        config["management"]["node_addresses"]["last"]
    )

    recycled = sorted(
        int(value)
        for value in allocation.get(
            "recycled_node_addresses",
            [],
        )
    )

    planned = []
    remaining_recycled = list(recycled)

    while len(planned) < count:

        if next_node <= last_node:
            host_number = next_node
            next_node += 1

        elif remaining_recycled:
            host_number = remaining_recycled.pop(0)

        else:
            raise LabMgmtError(
                f"Lab '{lab_data['lab']['key']}' has no "
                "management addresses available"
            )

        address = subnet.network_address + host_number

        planned.append(
            {
                "host_number": host_number,
                "ip": str(address),
            }
        )

    return planned, next_node, remaining_recycled

def canonical_name(name):
    """
    Convert a Containerlab name into a stable IPAM/DNS key.

    Examples:
        Simple       -> simple
        My_MPLS_Lab  -> my-mpls-lab
        EVPN Test     -> evpn-test
    """
    value = name.strip().lower()
    value = re.sub(r"[^a-z0-9-]+", "-", value)
    value = re.sub(r"-+", "-", value)
    value = value.strip("-")

    if not value:
        raise LabMgmtError(
            f"Name '{name}' cannot be converted into a valid IPAM/DNS key"
        )

    return value

def plan_next_lab_id(config, registry):
    first_lab = int(
        config["management"]["lab_ids"]["first"]
    )

    last_lab = int(
        config["management"]["lab_ids"]["last"]
    )

    allocation = registry["allocation"]

    next_lab_id = int(
        allocation["next_lab_id"]
    )

    recycled = sorted(
        int(value)
        for value in allocation.get(
            "recycled_lab_ids",
            [],
        )
    )

    #
    # Normal policy:
    # consume never-before-used Lab IDs first.
    #
    if next_lab_id <= last_lab:
        return {
            "lab_id": next_lab_id,
            "source": "high-water",
        }

    #
    # Only when the high-water range is exhausted
    # do we consume explicitly recycled IDs.
    #
    if recycled:
        return {
            "lab_id": recycled[0],
            "source": "recycled",
        }

    raise LabMgmtError(
        f"No Lab IDs are available in the "
        f"allowed range {first_lab}-{last_lab}"
    )


def consume_lab_id(registry, plan):
    lab_id = int(
        plan["lab_id"]
    )

    source = plan["source"]

    if source == "high-water":
        registry["allocation"][
            "next_lab_id"
        ] = lab_id + 1

        return

    if source == "recycled":
        recycled = [
            int(value)
            for value in registry[
                "allocation"
            ].get(
                "recycled_lab_ids",
                [],
            )
        ]

        if lab_id not in recycled:
            raise LabMgmtError(
                f"Recycled Lab ID {lab_id} "
                "is no longer available"
            )

        recycled.remove(
            lab_id
        )

        registry["allocation"][
            "recycled_lab_ids"
        ] = sorted(recycled)

        return

    raise LabMgmtError(
        f"Unknown Lab-ID allocation source: "
        f"{source}"
    )

def write_bytes_atomic_create(
    path,
    content,
    mode=0o644,
):
    path = Path(path)

    path.parent.mkdir(
        parents=True,
        exist_ok=True,
    )

    temp_path = path.with_name(
        f".{path.name}.tmp-{os.getpid()}"
    )

    try:
        with temp_path.open("wb") as f:
            f.write(content)
            f.flush()
            os.fsync(f.fileno())

        os.chmod(
            temp_path,
            mode,
        )

        os.replace(
            temp_path,
            path,
        )

    except Exception as exc:
        try:
            temp_path.unlink(
                missing_ok=True
            )
        except OSError:
            pass

        raise LabMgmtError(
            f"Unable to write {path}: {exc}"
        )

def calculate_lab_subnet(config, lab_id):
    mgmt = config["management"]

    supernet = ipaddress.ip_network(mgmt["supernet"])
    lab_prefix = int(mgmt["lab_prefix"])

    if lab_prefix < supernet.prefixlen:
        raise LabMgmtError(
            f"Lab prefix /{lab_prefix} cannot be shorter than "
            f"supernet {supernet}"
        )

    subnet_size = 2 ** (32 - lab_prefix)
    subnet_address = int(supernet.network_address) + (lab_id * subnet_size)

    subnet = ipaddress.ip_network(
        (ipaddress.ip_address(subnet_address), lab_prefix)
    )

    if not subnet.subnet_of(supernet):
        raise LabMgmtError(
            f"Lab ID {lab_id} produces subnet {subnet}, "
            f"outside management supernet {supernet}"
        )

    return subnet


def parse_topology(path):
    data = load_yaml(path)

    lab_name = data.get("name")
    if not isinstance(lab_name, str) or not lab_name.strip():
        raise LabMgmtError(
            f"{path} does not contain a valid top-level 'name:'"
        )

    topology = data.get("topology")
    if not isinstance(topology, dict):
        raise LabMgmtError(
            f"{path} does not contain a valid 'topology:' section"
        )

    nodes = topology.get("nodes")
    if not isinstance(nodes, dict) or not nodes:
        raise LabMgmtError(
            f"{path} does not contain any topology nodes"
        )

    parsed_nodes = []

    canonical_seen = {}

    for node_name, node_data in nodes.items():
        node_key = canonical_name(node_name)

        if node_key in canonical_seen:
            raise LabMgmtError(
                f"Node-name collision: '{node_name}' and "
                f"'{canonical_seen[node_key]}' both normalize to '{node_key}'"
            )

        canonical_seen[node_key] = node_name

        if node_data is None:
            node_data = {}

        if not isinstance(node_data, dict):
            raise LabMgmtError(
                f"Node '{node_name}' does not contain a valid mapping"
            )

        parsed_nodes.append(
            {
                "name": node_name,
                "key": node_key,
                "kind": node_data.get("kind", ""),
                "image": node_data.get("image", ""),
                "mgmt_ipv4": node_data.get("mgmt-ipv4"),
            }
        )
    mgmt = data.get("mgmt")

    if mgmt is None:
        mgmt = {}

    if not isinstance(mgmt, dict):
        raise LabMgmtError(
            f"{path} contains an invalid top-level 'mgmt:' section"
        )

    return {
        "name": lab_name,
        "key": canonical_name(lab_name),
        "mgmt": mgmt,
        "nodes": parsed_nodes,
    }

def calculate_lab_gateway(config, lab_id):
    subnet = calculate_lab_subnet(config, lab_id)

    gateway_host = int(
        config["management"]["gateway_address"]
    )

    gateway = subnet.network_address + gateway_host

    if gateway not in subnet:
        raise LabMgmtError(
            f"Gateway .{gateway_host} is outside subnet {subnet}"
        )

    return gateway


def management_network_name(config, lab_key):
    prefix = config["management"]["network_name_prefix"]
    return f"{prefix}{lab_key}"

def command_nexus(args):
    config = load_yaml(
        CONFIG_FILE
    )

    registry = load_yaml(
        REGISTRY_FILE
    )

    validate_config(
        config
    )

    validate_registry(
        config,
        registry,
    )

    topology_path = resolve_topology_path(
        args.topology
    )

    topo = parse_topology(
        topology_path
    )

    lab_key = topo["key"]

    if lab_key not in registry.get("labs", {}):
        raise LabMgmtError(
            f"Lab '{topo['name']}' is not registered.\n"
            f"Register it first with:\n"
            f"  labmgmt register {lab_key}"
        )

    lab_file = (
        LABS_DIR
        / f"{lab_key}.yml"
    )

    lab_data = load_yaml(
        lab_file
    )

    overrides = (
        lab_data
        .setdefault("nexus", {})
        .setdefault("usernames", {})
    )

    changed = False

    #
    # Ask only about nodes for which we cannot
    # automatically determine an SSH username.
    #
    for node in topo["nodes"]:
        username = get_nexus_username(
            node,
            lab_data,
        )

        if username is not None:
            continue

        print()
        print(
            f"Nexus username unknown for "
            f"'{node['name']}'"
        )

        print(
            f"  kind:   {node.get('kind', '')}"
        )

        print(
            f"  image:  {node.get('image', '')}"
        )

        print()

        answer = input(
            "SSH username [Enter to skip]: "
        ).strip()

        if not answer:
            continue

        overrides[node["key"]] = answer
        changed = True

    #
    # Save any manually supplied usernames.
    #
    if changed:
        write_yaml_atomic(
            lab_file,
            lab_data,
        )

    #
    # Build and write the complete inventory,
    # including any newly supplied overrides.
    #
    rows, skipped = build_nexus_inventory(
        topo,
        lab_data,
    )

    output_file = write_nexus_csv(
        topology_path,
        topo,
        rows,
    )

    print_nexus_summary(
        lab_key,
        rows,
        skipped,
    )

    print()
    print(
        f"Generated:  {output_file}"
    )

def get_nexus_username(node, lab_data=None):
    kind = node.get("kind", "")
    image = node.get("image", "")
    node_key = node.get("key")

    #
    # First honor a per-node username override saved
    # by "labmgmt nexus".
    #
    if lab_data is not None:
        overrides = (
            lab_data
            .get("nexus", {})
            .get("usernames", {})
        )

        if node_key in overrides:
            return overrides[node_key]

    #
    # Known Juniper platforms.
    #
    if kind in {
        "juniper_vjunosrouter",
        "juniper_vjunosswitch",
        "juniper_vjunosevolved",
        "juniper_vsrx",
    }:
        return "admin"

    #
    # Our custom labhost image.
    #
    if (
        kind == "linux"
        and (
            image.startswith("labhost:")
            or image.startswith("ghcr.io/sphoffman/labhost:")
        )
    ):
        return "lab"

    #
    # Unknown type/image.
    #
    return None


def build_nexus_inventory(topo, lab_data):
    rows = []
    skipped = []

    lab_key = topo["key"]

    for node in topo["nodes"]:
        username = get_nexus_username(
            node,
            lab_data,
        )

        if username is None:
            skipped.append(node)
            continue

        rows.append({
            "name": node["name"],
            "host": f"{node['key']}.{lab_key}",
            "port": 22,
            "username": username,
        })

    return rows, skipped


def write_nexus_csv(topology_path, topo, rows):
    output_file = (
        topology_path.parent
        / f"{topo['name']}.nexus.csv"
    )

    temp_file = output_file.with_suffix(
        output_file.suffix + ".tmp"
    )

    with temp_file.open(
        "w",
        newline="",
        encoding="utf-8",
    ) as handle:
        writer = csv.DictWriter(
            handle,
            fieldnames=[
                "name",
                "host",
                "port",
                "username",
            ],
        )

        writer.writeheader()
        writer.writerows(rows)

    temp_file.replace(output_file)

    return output_file


def print_nexus_summary(lab_key, rows, skipped):
    print()
    print(
        "================================================"
    )
    print("NEXUS INVENTORY")
    print(
        "================================================"
    )

    print()

    for row in rows:
        print(
            f"{row['name']:<20} "
            f"{row['host']:<30} "
            f"{row['username']}"
        )

    if skipped:
        print()
        print(
            "WARNING: Nexus username unknown "
            "for the following nodes:"
        )

        for node in skipped:
            print(
                f"  {node['name']:<20} "
                f"kind={node.get('kind', '')} "
                f"image={node.get('image', '')}"
            )

        print()
        print(
            "These nodes were skipped from the "
            "Nexus inventory."
        )
        print(
            f"Run 'labmgmt nexus {lab_key}' "
            "to assign usernames interactively."
        )

def validate_config(config):
    if config.get("version") != 1:
        raise LabMgmtError("Unsupported or missing config version")

    try:
        mgmt = config["management"]

        supernet = ipaddress.ip_network(mgmt["supernet"])
        lab_prefix = int(mgmt["lab_prefix"])

        first_lab = int(mgmt["lab_ids"]["first"])
        last_lab = int(mgmt["lab_ids"]["last"])

        first_node = int(mgmt["node_addresses"]["first"])
        last_node = int(mgmt["node_addresses"]["last"])

        network_prefix = str(
            mgmt["network_name_prefix"]
        )

        gateway_address = int(
            mgmt["gateway_address"]
        )

    except (KeyError, TypeError, ValueError) as exc:
        raise LabMgmtError(
            f"Invalid management configuration: {exc}"
        )

    if supernet.version != 4:
        raise LabMgmtError(
            "Only IPv4 management networks are supported"
        )

    if lab_prefix <= supernet.prefixlen:
        raise LabMgmtError(
            "lab_prefix must create smaller networks inside the supernet"
        )

    if first_lab < 0 or last_lab < first_lab:
        raise LabMgmtError(
            "Invalid Lab ID range"
        )

    if first_node < 1 or last_node > 254 or last_node < first_node:
        raise LabMgmtError(
            "Invalid node-address range"
        )

    if not network_prefix:
        raise LabMgmtError(
            "management.network_name_prefix cannot be empty"
        )

    if not 1 <= gateway_address <= 254:
        raise LabMgmtError(
            "management.gateway_address must be 1-254"
        )

    if first_node <= gateway_address <= last_node:
        raise LabMgmtError(
            f"Gateway address .{gateway_address} overlaps "
            "the normal node allocation range"
        )
    try:
        labs_root = Path(
            config["labs_root"]
        ).expanduser()
        if not labs_root.is_absolute():
            labs_root = (REPO_ROOT / labs_root).resolve()
    except (KeyError, TypeError) as exc:
        raise LabMgmtError(
            f"Invalid labs_root configuration: {exc}"
        )

    if not labs_root.exists():
        raise LabMgmtError(
            f"labs_root does not exist: {labs_root}"
        )

    if not labs_root.is_dir():
        raise LabMgmtError(
            f"labs_root is not a directory: {labs_root}"
        )

def validate_registry(config, registry):
    if registry.get("version") != 1:
        raise LabMgmtError("Unsupported or missing registry version")

    allocation = registry.get("allocation")
    labs = registry.get("labs")

    if not isinstance(allocation, dict):
        raise LabMgmtError("Registry is missing 'allocation:'")

    if not isinstance(labs, dict):
        raise LabMgmtError("Registry 'labs:' must be a mapping")

    try:
        next_lab_id = int(allocation["next_lab_id"])
    except (KeyError, TypeError, ValueError):
        raise LabMgmtError(
            "Registry allocation.next_lab_id is missing or invalid"
        )

    first_lab = int(config["management"]["lab_ids"]["first"])
    last_lab = int(config["management"]["lab_ids"]["last"])

    if not first_lab <= next_lab_id <= last_lab + 1:
        raise LabMgmtError(
            f"next_lab_id {next_lab_id} is outside the allowed range"
        )

    used_ids = {}

    for lab_key, entry in labs.items():
        if not isinstance(entry, dict):
            raise LabMgmtError(
                f"Registry entry '{lab_key}' must be a mapping"
            )

        try:
            lab_id = int(entry["lab_id"])
        except (KeyError, TypeError, ValueError):
            raise LabMgmtError(
                f"Lab '{lab_key}' has an invalid lab_id"
            )

        if lab_id in used_ids:
            raise LabMgmtError(
                f"Lab ID collision: '{lab_key}' and "
                f"'{used_ids[lab_id]}' both use Lab ID {lab_id}"
            )

        used_ids[lab_id] = lab_key

        if not first_lab <= lab_id <= last_lab:
            raise LabMgmtError(
                f"Lab '{lab_key}' has Lab ID {lab_id}, "
                f"outside allowed range {first_lab}-{last_lab}"
            )

        calculate_lab_subnet(config, lab_id)

    # The high-water mark must always be beyond every Lab ID
    # that has already been allocated.
    if used_ids and next_lab_id <= max(used_ids):
        raise LabMgmtError(
            f"next_lab_id {next_lab_id} is not above the highest "
            f"allocated Lab ID {max(used_ids)}"
        )

    recycled = allocation.get("recycled_lab_ids", [])

    if not isinstance(recycled, list):
        raise LabMgmtError(
            "allocation.recycled_lab_ids must be a list"
        )

    seen_recycled = set()

    for value in recycled:
        try:
            recycled_id = int(value)
        except (TypeError, ValueError):
            raise LabMgmtError(
                f"Invalid recycled Lab ID: {value}"
            )

        if recycled_id in seen_recycled:
            raise LabMgmtError(
                f"Duplicate recycled Lab ID: {recycled_id}"
            )

        seen_recycled.add(recycled_id)

        if not first_lab <= recycled_id <= last_lab:
            raise LabMgmtError(
                f"Recycled Lab ID {recycled_id} is outside "
                f"{first_lab}-{last_lab}"
            )

        if recycled_id in used_ids:
            raise LabMgmtError(
                f"Lab ID {recycled_id} is both allocated and recycled"
            )

        if recycled_id >= next_lab_id:
            raise LabMgmtError(
                f"Recycled Lab ID {recycled_id} has never been "
                f"allocated; next_lab_id is {next_lab_id}"
            )

def validate_lab_file(config, lab_key, registry_entry, path):
    data = load_yaml(path)
    warnings = []

    if data.get("version") != 1:
        raise LabMgmtError(
            f"{path}: unsupported or missing version"
        )

    lab = data.get("lab")
    allocation = data.get("allocation")
    nodes = data.get("nodes")

    if not isinstance(lab, dict):
        raise LabMgmtError(
            f"{path}: missing or invalid 'lab:' section"
        )

    if not isinstance(allocation, dict):
        raise LabMgmtError(
            f"{path}: missing or invalid 'allocation:' section"
        )

    if not isinstance(nodes, dict):
        raise LabMgmtError(
            f"{path}: 'nodes:' must be a mapping"
        )

    #
    # Validate lab identity.
    #
    stored_key = lab.get("key")

    if stored_key != lab_key:
        raise LabMgmtError(
            f"{path}: lab key '{stored_key}' does not match "
            f"registry key '{lab_key}'"
        )

    lab_name = lab.get("name")

    if not isinstance(lab_name, str) or not lab_name.strip():
        raise LabMgmtError(
            f"{path}: lab.name is missing or invalid"
        )

    if canonical_name(lab_name) != lab_key:
        raise LabMgmtError(
            f"{path}: lab name '{lab_name}' normalizes to "
            f"'{canonical_name(lab_name)}', not '{lab_key}'"
        )

    try:
        lab_id = int(lab["lab_id"])
        registry_lab_id = int(registry_entry["lab_id"])
    except (KeyError, TypeError, ValueError):
        raise LabMgmtError(
            f"{path}: invalid Lab ID"
        )

    if lab_id != registry_lab_id:
        raise LabMgmtError(
            f"{path}: Lab ID {lab_id} does not match registry "
            f"Lab ID {registry_lab_id}"
        )

    #
    # Validate status.
    #
    lab_status = lab.get("status")
    registry_status = registry_entry.get("status")

    if lab_status not in ("active", "retired"):
        raise LabMgmtError(
            f"{path}: invalid lab status '{lab_status}'"
        )

    if registry_status != lab_status:
        raise LabMgmtError(
            f"{path}: status '{lab_status}' does not match "
            f"registry status '{registry_status}'"
        )

    #
    # Validate subnet.
    #
    expected_subnet = calculate_lab_subnet(config, lab_id)

    try:
        stored_subnet = ipaddress.ip_network(
            str(lab["subnet"]),
            strict=True,
        )
    except (KeyError, ValueError):
        raise LabMgmtError(
            f"{path}: invalid or missing subnet"
        )

    if stored_subnet != expected_subnet:
        raise LabMgmtError(
            f"{path}: Lab ID {lab_id} requires subnet "
            f"{expected_subnet}, but file contains {stored_subnet}"
        )

    #
    # Validate topology path.
    #
    topology_value = lab.get("topology")

    if not isinstance(topology_value, str) or not topology_value:
        raise LabMgmtError(
            f"{path}: missing topology path"
        )

    topology_relative = Path(topology_value)

    if topology_relative.is_absolute():
        raise LabMgmtError(
            f"{path}: topology path must be relative to {REPO_ROOT}"
        )

    topology_path = (REPO_ROOT / topology_relative).resolve()

    try:
        topology_path.relative_to(REPO_ROOT.resolve())
    except ValueError:
        raise LabMgmtError(
            f"{path}: topology path escapes repository: "
            f"{topology_value}"
        )

    # A moved topology is not IPAM corruption, so warn rather than fail.
    if not topology_path.exists():
        warnings.append(
            f"{lab_key}: topology not found: {topology_value}"
        )

    #
    # Validate node allocations.
    #
    first_node = int(
        config["management"]["node_addresses"]["first"]
    )
    last_node = int(
        config["management"]["node_addresses"]["last"]
    )

    used_ips = {}
    host_numbers = []

    active_count = 0
    retired_count = 0

    for node_key, node in nodes.items():

        if not isinstance(node, dict):
            raise LabMgmtError(
                f"{path}: node '{node_key}' must be a mapping"
            )

        node_name = node.get("name")

        if not isinstance(node_name, str) or not node_name:
            raise LabMgmtError(
                f"{path}: node '{node_key}' has no valid name"
            )

        expected_key = canonical_name(node_name)

        if expected_key != node_key:
            raise LabMgmtError(
                f"{path}: node '{node_name}' normalizes to "
                f"'{expected_key}', but is stored as '{node_key}'"
            )

        status = node.get("status")

        if status == "active":
            active_count += 1
        elif status == "retired":
            retired_count += 1
        else:
            raise LabMgmtError(
                f"{path}: node '{node_key}' has invalid "
                f"status '{status}'"
            )

        try:
            address = ipaddress.ip_address(str(node["ip"]))
        except (KeyError, ValueError):
            raise LabMgmtError(
                f"{path}: node '{node_key}' has invalid IP"
            )

        if address.version != 4:
            raise LabMgmtError(
                f"{path}: node '{node_key}' must use IPv4"
            )

        if address not in expected_subnet:
            raise LabMgmtError(
                f"{path}: node '{node_key}' address {address} "
                f"is outside {expected_subnet}"
            )

        host_number = (
            int(address)
            - int(expected_subnet.network_address)
        )

        if not first_node <= host_number <= last_node:
            raise LabMgmtError(
                f"{path}: node '{node_key}' address {address} "
                f"is outside allowed node range "
                f".{first_node}-.{last_node}"
            )

        if address in used_ips:
            raise LabMgmtError(
                f"{path}: duplicate IP {address} used by "
                f"'{node_key}' and '{used_ips[address]}'"
            )

        used_ips[address] = node_key
        host_numbers.append(host_number)

    #
    # Validate node high-water mark.
    #
    try:
        next_node = int(allocation["next_node_address"])
    except (KeyError, TypeError, ValueError):
        raise LabMgmtError(
            f"{path}: invalid allocation.next_node_address"
        )

    if not first_node <= next_node <= last_node + 1:
        raise LabMgmtError(
            f"{path}: next_node_address {next_node} is outside "
            f"allowed range {first_node}-{last_node + 1}"
        )

    if host_numbers and next_node <= max(host_numbers):
        raise LabMgmtError(
            f"{path}: next_node_address {next_node} is not above "
            f"highest allocated address .{max(host_numbers)}"
        )

    #
    # Validate recycled addresses.
    #
    recycled = allocation.get(
        "recycled_node_addresses",
        [],
    )

    if not isinstance(recycled, list):
        raise LabMgmtError(
            f"{path}: recycled_node_addresses must be a list"
        )

    seen_recycled = set()

    for value in recycled:
        try:
            recycled_host = int(value)
        except (TypeError, ValueError):
            raise LabMgmtError(
                f"{path}: invalid recycled node address '{value}'"
            )

        if recycled_host in seen_recycled:
            raise LabMgmtError(
                f"{path}: duplicate recycled address "
                f".{recycled_host}"
            )

        seen_recycled.add(recycled_host)

        if not first_node <= recycled_host <= last_node:
            raise LabMgmtError(
                f"{path}: recycled address .{recycled_host} "
                f"is outside allowed range"
            )

        if recycled_host >= next_node:
            raise LabMgmtError(
                f"{path}: recycled address .{recycled_host} "
                f"has never been allocated"
            )

        recycled_ip = (
            expected_subnet.network_address + recycled_host
        )

        if recycled_ip in used_ips:
            raise LabMgmtError(
                f"{path}: {recycled_ip} is both allocated "
                f"and recycled"
            )

    return {
        "data": data,
        "ips": used_ips,
        "active_nodes": active_count,
        "retired_nodes": retired_count,
        "warnings": warnings,
    }

def validate_lab_file(config, lab_key, registry_entry, path):
    data = load_yaml(path)
    warnings = []

    if data.get("version") != 1:
        raise LabMgmtError(
            f"{path}: unsupported or missing version"
        )

    lab = data.get("lab")
    allocation = data.get("allocation")
    nodes = data.get("nodes")

    if not isinstance(lab, dict):
        raise LabMgmtError(
            f"{path}: missing or invalid 'lab:' section"
        )

    if not isinstance(allocation, dict):
        raise LabMgmtError(
            f"{path}: missing or invalid 'allocation:' section"
        )

    if not isinstance(nodes, dict):
        raise LabMgmtError(
            f"{path}: 'nodes:' must be a mapping"
        )

    #
    # Validate lab identity.
    #
    stored_key = lab.get("key")

    if stored_key != lab_key:
        raise LabMgmtError(
            f"{path}: lab key '{stored_key}' does not match "
            f"registry key '{lab_key}'"
        )

    lab_name = lab.get("name")

    if not isinstance(lab_name, str) or not lab_name.strip():
        raise LabMgmtError(
            f"{path}: lab.name is missing or invalid"
        )

    if canonical_name(lab_name) != lab_key:
        raise LabMgmtError(
            f"{path}: lab name '{lab_name}' normalizes to "
            f"'{canonical_name(lab_name)}', not '{lab_key}'"
        )

    try:
        lab_id = int(lab["lab_id"])
        registry_lab_id = int(registry_entry["lab_id"])
    except (KeyError, TypeError, ValueError):
        raise LabMgmtError(
            f"{path}: invalid Lab ID"
        )

    if lab_id != registry_lab_id:
        raise LabMgmtError(
            f"{path}: Lab ID {lab_id} does not match registry "
            f"Lab ID {registry_lab_id}"
        )

    #
    # Validate status.
    #
    lab_status = lab.get("status")
    registry_status = registry_entry.get("status")

    if lab_status not in ("active", "retired"):
        raise LabMgmtError(
            f"{path}: invalid lab status '{lab_status}'"
        )

    if registry_status != lab_status:
        raise LabMgmtError(
            f"{path}: status '{lab_status}' does not match "
            f"registry status '{registry_status}'"
        )

    #
    # Validate subnet.
    #
    expected_subnet = calculate_lab_subnet(config, lab_id)

    try:
        stored_subnet = ipaddress.ip_network(
            str(lab["subnet"]),
            strict=True,
        )
    except (KeyError, ValueError):
        raise LabMgmtError(
            f"{path}: invalid or missing subnet"
        )

    if stored_subnet != expected_subnet:
        raise LabMgmtError(
            f"{path}: Lab ID {lab_id} requires subnet "
            f"{expected_subnet}, but file contains {stored_subnet}"
        )

    #
    # Validate topology path.
    #
    topology_value = lab.get("topology")

    if not isinstance(topology_value, str) or not topology_value:
        raise LabMgmtError(
            f"{path}: missing topology path"
        )

    topology_relative = Path(topology_value)

    if topology_relative.is_absolute():
        raise LabMgmtError(
            f"{path}: topology path must be relative to {REPO_ROOT}"
        )

    topology_path = (REPO_ROOT / topology_relative).resolve()

    try:
        topology_path.relative_to(REPO_ROOT.resolve())
    except ValueError:
        raise LabMgmtError(
            f"{path}: topology path escapes repository: "
            f"{topology_value}"
        )

    # A moved topology is not IPAM corruption, so warn rather than fail.
    if not topology_path.exists():
        warnings.append(
            f"{lab_key}: topology not found: {topology_value}"
        )

    #
    # Validate node allocations.
    #
    first_node = int(
        config["management"]["node_addresses"]["first"]
    )
    last_node = int(
        config["management"]["node_addresses"]["last"]
    )

    used_ips = {}
    host_numbers = []

    active_count = 0
    retired_count = 0

    for node_key, node in nodes.items():

        if not isinstance(node, dict):
            raise LabMgmtError(
                f"{path}: node '{node_key}' must be a mapping"
            )

        node_name = node.get("name")

        if not isinstance(node_name, str) or not node_name:
            raise LabMgmtError(
                f"{path}: node '{node_key}' has no valid name"
            )

        expected_key = canonical_name(node_name)

        if expected_key != node_key:
            raise LabMgmtError(
                f"{path}: node '{node_name}' normalizes to "
                f"'{expected_key}', but is stored as '{node_key}'"
            )

        status = node.get("status")

        if status == "active":
            active_count += 1
        elif status == "retired":
            retired_count += 1
        else:
            raise LabMgmtError(
                f"{path}: node '{node_key}' has invalid "
                f"status '{status}'"
            )

        try:
            address = ipaddress.ip_address(str(node["ip"]))
        except (KeyError, ValueError):
            raise LabMgmtError(
                f"{path}: node '{node_key}' has invalid IP"
            )

        if address.version != 4:
            raise LabMgmtError(
                f"{path}: node '{node_key}' must use IPv4"
            )

        if address not in expected_subnet:
            raise LabMgmtError(
                f"{path}: node '{node_key}' address {address} "
                f"is outside {expected_subnet}"
            )

        host_number = (
            int(address)
            - int(expected_subnet.network_address)
        )

        if not first_node <= host_number <= last_node:
            raise LabMgmtError(
                f"{path}: node '{node_key}' address {address} "
                f"is outside allowed node range "
                f".{first_node}-.{last_node}"
            )

        if address in used_ips:
            raise LabMgmtError(
                f"{path}: duplicate IP {address} used by "
                f"'{node_key}' and '{used_ips[address]}'"
            )

        used_ips[address] = node_key
        host_numbers.append(host_number)

    #
    # Validate node high-water mark.
    #
    try:
        next_node = int(allocation["next_node_address"])
    except (KeyError, TypeError, ValueError):
        raise LabMgmtError(
            f"{path}: invalid allocation.next_node_address"
        )

    if not first_node <= next_node <= last_node + 1:
        raise LabMgmtError(
            f"{path}: next_node_address {next_node} is outside "
            f"allowed range {first_node}-{last_node + 1}"
        )

    if host_numbers and next_node <= max(host_numbers):
        raise LabMgmtError(
            f"{path}: next_node_address {next_node} is not above "
            f"highest allocated address .{max(host_numbers)}"
        )

    #
    # Validate recycled addresses.
    #
    recycled = allocation.get(
        "recycled_node_addresses",
        [],
    )

    if not isinstance(recycled, list):
        raise LabMgmtError(
            f"{path}: recycled_node_addresses must be a list"
        )

    seen_recycled = set()

    for value in recycled:
        try:
            recycled_host = int(value)
        except (TypeError, ValueError):
            raise LabMgmtError(
                f"{path}: invalid recycled node address '{value}'"
            )

        if recycled_host in seen_recycled:
            raise LabMgmtError(
                f"{path}: duplicate recycled address "
                f".{recycled_host}"
            )

        seen_recycled.add(recycled_host)

        if not first_node <= recycled_host <= last_node:
            raise LabMgmtError(
                f"{path}: recycled address .{recycled_host} "
                f"is outside allowed range"
            )

        if recycled_host >= next_node:
            raise LabMgmtError(
                f"{path}: recycled address .{recycled_host} "
                f"has never been allocated"
            )

        recycled_ip = (
            expected_subnet.network_address + recycled_host
        )

        if recycled_ip in used_ips:
            raise LabMgmtError(
                f"{path}: {recycled_ip} is both allocated "
                f"and recycled"
            )

    return {
        "data": data,
        "ips": used_ips,
        "active_nodes": active_count,
        "retired_nodes": retired_count,
        "warnings": warnings,
    }

def validate_ipam_state(config, registry):
    global_ips = {}
    warnings = []

    total_active = 0
    total_retired = 0

    labs = registry.get("labs", {})

    for lab_key, registry_entry in labs.items():

        file_value = registry_entry.get("file")

        if not isinstance(file_value, str) or not file_value:
            raise LabMgmtError(
                f"Registry lab '{lab_key}' has no valid file"
            )

        lab_file = (IPAM_DIR / file_value).resolve()

        try:
            lab_file.relative_to(IPAM_DIR.resolve())
        except ValueError:
            raise LabMgmtError(
                f"Registry lab '{lab_key}' points outside "
                f"the IPAM directory"
            )

        if not lab_file.exists():
            raise LabMgmtError(
                f"Registry lab '{lab_key}' references missing "
                f"file: {lab_file}"
            )

        result = validate_lab_file(
            config,
            lab_key,
            registry_entry,
            lab_file,
        )

        total_active += result["active_nodes"]
        total_retired += result["retired_nodes"]
        warnings.extend(result["warnings"])

        for address, node_key in result["ips"].items():

            if address in global_ips:
                old_lab, old_node = global_ips[address]

                raise LabMgmtError(
                    f"Global IP collision: {address} is used by "
                    f"{old_node}.{old_lab} and "
                    f"{node_key}.{lab_key}"
                )

            global_ips[address] = (
                lab_key,
                node_key,
            )

    return {
        "active_nodes": total_active,
        "retired_nodes": total_retired,
        "warnings": warnings,
    }

def build_sync_plan(config, registry, topology_path):
    topo = parse_topology(topology_path)

    lab_key = topo["key"]

    registry_entry = registry.get(
        "labs",
        {},
    ).get(lab_key)

    if registry_entry is None:
        raise LabMgmtError(
            f"Lab '{lab_key}' is not registered. "
            f"Use 'labmgmt register {lab_key}' first."
        )

    if registry_entry.get("status") != "active":
        raise LabMgmtError(
            f"Lab '{lab_key}' is retired.\n"
            "Reactivate it before syncing."
        )

    lab_file = (
        IPAM_DIR / registry_entry["file"]
    ).resolve()

    lab_data = load_yaml(lab_file)

    #
    # The entire IPAM has already been validated before
    # this function is called, so these structures can
    # now be trusted.
    #
    ipam_nodes = lab_data["nodes"]

    topology_nodes = {
        node["key"]: node
        for node in topo["nodes"]
    }

    topology_order = [
        node["key"]
        for node in topo["nodes"]
    ]

    unchanged = []
    returning = []
    new = []
    retiring = []
    already_retired = []

    #
    # First classify everything present in the topology.
    #
    for node in topo["nodes"]:
        node_key = node["key"]

        if node_key not in ipam_nodes:
            new.append(
                {
                    "key": node_key,
                    "name": node["name"],
                    "topology_node": node,
                }
            )
            continue

        stored = ipam_nodes[node_key]

        result = {
            "key": node_key,
            "name": node["name"],
            "stored_name": stored["name"],
            "ip": stored["ip"],
            "topology_node": node,
            "name_changed": (
                node["name"] != stored["name"]
            ),
        }

        if stored["status"] == "active":
            unchanged.append(result)

        elif stored["status"] == "retired":
            returning.append(result)

        else:
            raise LabMgmtError(
                f"Unexpected node status for '{node_key}': "
                f"{stored['status']}"
            )

    #
    # Anything in IPAM but absent from the topology
    # either needs retirement or was already retired.
    #
    for node_key, stored in ipam_nodes.items():

        if node_key in topology_nodes:
            continue

        result = {
            "key": node_key,
            "name": stored["name"],
            "ip": stored["ip"],
        }

        if stored["status"] == "active":
            retiring.append(result)
        else:
            already_retired.append(result)

    #
    # Allocate addresses for genuinely new nodes.
    #
    allocations, resulting_next_node, remaining_recycled = (
        plan_new_node_addresses(
            config,
            lab_data,
            len(new),
        )
    )

    for node, allocation in zip(new, allocations):
        node["ip"] = allocation["ip"]
        node["host_number"] = allocation["host_number"]

    #
    # Compare the topology path to the one stored in IPAM.
    #
    current_topology = repo_relative(topology_path)
    stored_topology = lab_data["lab"]["topology"]

    topology_path_changed = (
        current_topology != stored_topology
    )

    #
    # Build node lookup in topology order for display.
    #
    assignments = {}

    for item in unchanged:
        assignments[item["key"]] = {
            **item,
            "action": "unchanged",
        }

    for item in returning:
        assignments[item["key"]] = {
            **item,
            "action": "returning",
        }

    for item in new:
        assignments[item["key"]] = {
            **item,
            "action": "new",
        }

    ordered_assignments = [
        assignments[key]
        for key in topology_order
    ]

    return {
        "topology": topo,
        "topology_path": current_topology,
        "stored_topology_path": stored_topology,
        "topology_path_changed": topology_path_changed,

        "lab_file": lab_file,
        "lab_data": lab_data,

        "unchanged": unchanged,
        "returning": returning,
        "new": new,
        "retiring": retiring,
        "already_retired": already_retired,

        "assignments": ordered_assignments,

        "resulting_next_node": resulting_next_node,
        "remaining_recycled": remaining_recycled,
    }

def run_command_checked(command, description):
    try:
        result = subprocess.run(
            command,
            capture_output=True,
            text=True,
        )

    except FileNotFoundError:
        raise LabMgmtError(
            f"Required command not found: {command[0]}"
        )

    if result.returncode != 0:
        output = (
            result.stderr.strip()
            or result.stdout.strip()
            or "no error output"
        )

        raise LabMgmtError(
            f"{description} failed:\n{output}"
        )

    return (
        result.stdout.strip()
        or result.stderr.strip()
    )


def replace_live_file_atomic(path, content):
    path = Path(path)

    if not path.exists():
        raise LabMgmtError(
            f"Live BIND file does not exist: {path}"
        )

    stat_info = path.stat()

    temp_path = path.with_name(
        f".{path.name}.labmgmt-{os.getpid()}"
    )

    try:
        with temp_path.open("wb") as f:
            f.write(content)
            f.flush()
            os.fsync(f.fileno())

        #
        # Preserve the original file's permissions,
        # owner and group.
        #
        os.chmod(
            temp_path,
            stat_info.st_mode & 0o7777,
        )

        os.chown(
            temp_path,
            stat_info.st_uid,
            stat_info.st_gid,
        )

        os.replace(
            temp_path,
            path,
        )

    except Exception as exc:
        try:
            temp_path.unlink(
                missing_ok=True
            )
        except OSError:
            pass

        raise LabMgmtError(
            f"Unable to install {path}: {exc}"
        )


def install_dns_zones(
    config,
    registry,
):
    #
    # This operation must run as root because it
    # modifies /etc/bind and invokes rndc.
    #
    if os.geteuid() != 0:
        raise LabMgmtError(
            "DNS installation requires root privileges. "
            "Run: sudo labmgmt dns install"
        )

    dns = config["dns"]

    forward_zone = dns["domain"]
    reverse_zone = dns["reverse_zone"]

    forward_live = Path(
        dns["bind"]["forward_zone_file"]
    )

    reverse_live = Path(
        dns["bind"]["reverse_zone_file"]
    )

    #
    # Staging files must already exist.
    #
    if not GENERATED_FORWARD_ZONE.exists():
        raise LabMgmtError(
            f"Generated forward zone is missing: "
            f"{GENERATED_FORWARD_ZONE}\n"
            "Run 'labmgmt dns' first."
        )

    if not GENERATED_REVERSE_ZONE.exists():
        raise LabMgmtError(
            f"Generated reverse zone is missing: "
            f"{GENERATED_REVERSE_ZONE}\n"
            "Run 'labmgmt dns' first."
        )

    #
    # Calculate what DNS should look like RIGHT NOW.
    #
    # This makes sure IPAM hasn't changed since
    # the staging files were generated.
    #
    serials = calculate_next_dns_serial(
        config
    )

    records = collect_dns_records(
        config,
        registry,
    )

    expected_forward = generate_forward_zone(
        config,
        serials["new"],
        records,
    )

    expected_reverse = generate_reverse_zone(
        config,
        serials["new"],
        records,
    )

    staged_forward = (
        GENERATED_FORWARD_ZONE.read_text(
            encoding="utf-8"
        )
    )

    staged_reverse = (
        GENERATED_REVERSE_ZONE.read_text(
            encoding="utf-8"
        )
    )

    if staged_forward != expected_forward:
        raise LabMgmtError(
            "Generated forward zone is stale or does not "
            "match current IPAM/live serial state.\n"
            "Run 'labmgmt dns' as your normal user first."
        )

    if staged_reverse != expected_reverse:
        raise LabMgmtError(
            "Generated reverse zone is stale or does not "
            "match current IPAM/live serial state.\n"
            "Run 'labmgmt dns' as your normal user first."
        )

    print()
    print("DNS INSTALL")
    print("===========")

    print()
    print("Pre-install validation")
    print("----------------------")

    #
    # Validate staging files.
    #
    validate_zone_file(
        forward_zone,
        GENERATED_FORWARD_ZONE,
    )

    print("Generated forward zone: OK")

    validate_zone_file(
        reverse_zone,
        GENERATED_REVERSE_ZONE,
    )

    print("Generated reverse zone: OK")

    #
    # Validate current BIND configuration before
    # modifying anything.
    #
    run_command_checked(
        ["named-checkconf"],
        "BIND configuration validation",
    )

    print("BIND configuration:      OK")

    #
    # Ensure the live files actually exist before
    # attempting a transactional replacement.
    #
    if not forward_live.exists():
        raise LabMgmtError(
            f"Live forward zone does not exist: "
            f"{forward_live}"
        )

    if not reverse_live.exists():
        raise LabMgmtError(
            f"Live reverse zone does not exist: "
            f"{reverse_live}"
        )

    #
    # Save exact originals in memory for rollback.
    #
    original_forward = (
        forward_live.read_bytes()
    )

    original_reverse = (
        reverse_live.read_bytes()
    )

    #
    # Also create persistent backups.
    #
    timestamp = (
        datetime.datetime.now()
        .strftime("%Y%m%d-%H%M%S")
    )

    common_parent = Path(
        os.path.commonpath(
            [
                str(forward_live.parent),
                str(reverse_live.parent),
            ]
        )
    )

    backup_dir = (
        common_parent
        / "labmgmt-backups"
        / timestamp
    )

    backup_dir.mkdir(
        parents=True,
        exist_ok=False,
    )

    os.chmod(
        backup_dir,
        0o750,
    )

    forward_backup = (
        backup_dir / forward_live.name
    )

    reverse_backup = (
        backup_dir / reverse_live.name
    )

    shutil.copy2(
        forward_live,
        forward_backup,
    )

    shutil.copy2(
        reverse_live,
        reverse_backup,
    )

    print()
    print("Backup")
    print("------")

    print(
        f"Created: {backup_dir}"
    )

    wrote_forward = False
    wrote_reverse = False

    try:
        #
        # Install both files atomically.
        #
        replace_live_file_atomic(
            forward_live,
            staged_forward.encode("utf-8"),
        )

        wrote_forward = True

        replace_live_file_atomic(
            reverse_live,
            staged_reverse.encode("utf-8"),
        )

        wrote_reverse = True

        #
        # Validate the complete BIND configuration
        # after installation.
        #
        run_command_checked(
            ["named-checkconf"],
            "Post-install BIND configuration validation",
        )

        #
        # Validate the LIVE zone files.
        #
        validate_zone_file(
            forward_zone,
            forward_live,
        )

        validate_zone_file(
            reverse_zone,
            reverse_live,
        )

        print()
        print("Post-install validation")
        print("-----------------------")

        print("BIND configuration: OK")
        print("Live forward zone:  OK")
        print("Live reverse zone:  OK")

        #
        # Only reload after ALL validation succeeds.
        #
        reload_output = run_command_checked(
            ["rndc", "reload"],
            "BIND reload",
        )

        print()
        print("BIND reload")
        print("-----------")

        if reload_output:
            print(reload_output)
        else:
            print("rndc reload: OK")

        #
        # Confirm that named is responding to rndc.
        #
        run_command_checked(
            ["rndc", "status"],
            "BIND status check",
        )

    except Exception as exc:
        print()
        print(
            "DNS installation failed; "
            "restoring previous zone files..."
        )

        rollback_errors = []

        if wrote_forward:
            try:
                replace_live_file_atomic(
                    forward_live,
                    original_forward,
                )
            except Exception as rollback_exc:
                rollback_errors.append(
                    f"forward rollback: "
                    f"{rollback_exc}"
                )

        if wrote_reverse:
            try:
                replace_live_file_atomic(
                    reverse_live,
                    original_reverse,
                )
            except Exception as rollback_exc:
                rollback_errors.append(
                    f"reverse rollback: "
                    f"{rollback_exc}"
                )

        #
        # Attempt to reload the restored zones.
        #
        if not rollback_errors:
            try:
                run_command_checked(
                    ["named-checkconf"],
                    "Rollback configuration validation",
                )

                validate_zone_file(
                    forward_zone,
                    forward_live,
                )

                validate_zone_file(
                    reverse_zone,
                    reverse_live,
                )

                run_command_checked(
                    ["rndc", "reload"],
                    "Rollback BIND reload",
                )

            except Exception as rollback_exc:
                rollback_errors.append(
                    f"rollback reload: "
                    f"{rollback_exc}"
                )

        if rollback_errors:
            raise LabMgmtError(
                f"DNS installation failed: {exc}\n"
                "Rollback also encountered errors:\n"
                + "\n".join(
                    f"  {error}"
                    for error in rollback_errors
                )
            )

        raise LabMgmtError(
            f"DNS installation failed and was "
            f"rolled back successfully: {exc}"
        )

    print()
    print("DNS installation successful.")
    print(
        f"Serial:          {serials['new']}"
    )
    print(
        f"Forward zone:    {forward_live}"
    )
    print(
        f"Reverse zone:    {reverse_live}"
    )
    print(
        f"Backup:          {backup_dir}"
    )

def validate_dns_config(config):
    try:
        dns = config["dns"]

        domain = str(dns["domain"]).strip()
        reverse_zone = str(dns["reverse_zone"]).strip()
        ttl = int(dns["ttl"])

        soa = dns["soa"]

        primary_ns = str(
            soa["primary_ns"]
        ).strip()

        responsible = str(
            soa["responsible"]
        ).strip()

        refresh = int(soa["refresh"])
        retry = int(soa["retry"])
        expire = int(soa["expire"])
        negative_ttl = int(
            soa["negative_ttl"]
        )

        nameserver = dns["nameserver"]

        ns_name = str(
            nameserver["name"]
        ).strip()

        ns_address = ipaddress.ip_address(
            str(nameserver["address"])
        )

        bind = dns["bind"]

        forward_file = Path(
            bind["forward_zone_file"]
        )

        reverse_file = Path(
            bind["reverse_zone_file"]
        )

    except (
        KeyError,
        TypeError,
        ValueError,
    ) as exc:
        raise LabMgmtError(
            f"Invalid DNS configuration: {exc}"
        )

    if not domain:
        raise LabMgmtError(
            "dns.domain cannot be empty"
        )

    if domain.endswith("."):
        raise LabMgmtError(
            "dns.domain should not end with a dot"
        )

    if not reverse_zone.endswith(
        ".in-addr.arpa"
    ):
        raise LabMgmtError(
            "dns.reverse_zone must be an "
            "in-addr.arpa zone"
        )

    if ttl <= 0:
        raise LabMgmtError(
            "dns.ttl must be greater than zero"
        )

    if not primary_ns.endswith("."):
        raise LabMgmtError(
            "dns.soa.primary_ns must be an "
            "absolute DNS name ending in '.'"
        )

    if not responsible.endswith("."):
        raise LabMgmtError(
            "dns.soa.responsible must be an "
            "absolute DNS name ending in '.'"
        )

    if not ns_name:
        raise LabMgmtError(
            "dns.nameserver.name cannot be empty"
        )

    if ns_address.version != 4:
        raise LabMgmtError(
            "DNS nameserver address must be IPv4"
        )

    for value, name in (
        (refresh, "refresh"),
        (retry, "retry"),
        (expire, "expire"),
        (
            negative_ttl,
            "negative_ttl",
        ),
    ):
        if value <= 0:
            raise LabMgmtError(
                f"dns.soa.{name} must be "
                "greater than zero"
            )

    if not forward_file.is_absolute():
        raise LabMgmtError(
            "Forward zone path must be absolute"
        )

    if not reverse_file.is_absolute():
        raise LabMgmtError(
            "Reverse zone path must be absolute"
        )


def read_zone_serial(path):
    path = Path(path)

    if not path.exists():
        raise LabMgmtError(
            f"DNS zone file does not exist: {path}"
        )

    try:
        text = path.read_text()

    except PermissionError:
        raise LabMgmtError(
            f"Unable to read DNS zone file: {path}"
        )

    except OSError as exc:
        raise LabMgmtError(
            f"Unable to read DNS zone file "
            f"{path}: {exc}"
        )

    match = re.search(
        r"\bSOA\b.*?\(\s*(\d+)",
        text,
        flags=re.DOTALL | re.IGNORECASE,
    )

    if not match:
        raise LabMgmtError(
            f"Unable to locate SOA serial in {path}"
        )

    return int(match.group(1))


def calculate_next_dns_serial(config):
    bind = config["dns"]["bind"]

    forward_file = Path(
        bind["forward_zone_file"]
    )

    reverse_file = Path(
        bind["reverse_zone_file"]
    )

    forward_serial = read_zone_serial(
        forward_file
    )

    reverse_serial = read_zone_serial(
        reverse_file
    )

    today = datetime.date.today()

    today_base = int(
        today.strftime("%Y%m%d") + "00"
    )

    highest_existing = max(
        forward_serial,
        reverse_serial,
    )

    new_serial = max(
        today_base,
        highest_existing,
    ) + 1

    return {
        "forward": forward_serial,
        "reverse": reverse_serial,
        "new": new_serial,
    }


def reverse_owner_for_ip(
    address,
    reverse_zone,
):
    address = ipaddress.ip_address(
        str(address)
    )

    if address.version != 4:
        raise LabMgmtError(
            "PTR generation currently supports "
            "IPv4 only"
        )

    suffix = ".in-addr.arpa"

    if not reverse_zone.endswith(suffix):
        raise LabMgmtError(
            f"Invalid reverse zone: {reverse_zone}"
        )

    prefix_text = reverse_zone[
        :-len(suffix)
    ].rstrip(".")

    zone_labels = [
        label
        for label in prefix_text.split(".")
        if label
    ]

    try:
        prefix_octets = [
            int(label)
            for label in reversed(
                zone_labels
            )
        ]

    except ValueError:
        raise LabMgmtError(
            f"Invalid reverse zone: {reverse_zone}"
        )

    address_octets = [
        int(value)
        for value in str(address).split(".")
    ]

    if (
        address_octets[
            :len(prefix_octets)
        ]
        != prefix_octets
    ):
        raise LabMgmtError(
            f"Address {address} does not belong "
            f"to reverse zone {reverse_zone}"
        )

    remaining = address_octets[
        len(prefix_octets):
    ]

    if not remaining:
        return "@"

    return ".".join(
        str(value)
        for value in reversed(remaining)
    )


def collect_dns_records(
    config,
    registry,
):
    records = []

    labs = registry.get("labs", {})

    ordered_labs = sorted(
        labs.items(),
        key=lambda item: int(
            item[1]["lab_id"]
        ),
    )

    for lab_key, registry_entry in ordered_labs:

        if (
            registry_entry.get("status")
            != "active"
        ):
            continue

        lab_file = (
            IPAM_DIR
            / registry_entry["file"]
        ).resolve()

        lab_data = load_yaml(
            lab_file
        )

        if (
            lab_data["lab"].get("status")
            != "active"
        ):
            continue

        lab_id = int(
            lab_data["lab"]["lab_id"]
        )

        lab_records = []

        for node_key, node in (
            lab_data["nodes"].items()
        ):
            if node.get("status") != "active":
                continue

            address = ipaddress.ip_address(
                str(node["ip"])
            )

            lab_records.append(
                {
                    "node_key": node_key,
                    "node_name": node["name"],
                    "lab_key": lab_key,
                    "lab_name": (
                        lab_data["lab"]["name"]
                    ),
                    "lab_id": lab_id,
                    "subnet": (
                        lab_data["lab"]["subnet"]
                    ),
                    "ip": str(address),
                    "ip_int": int(address),
                }
            )

        lab_records.sort(
            key=lambda item: item["ip_int"]
        )

        records.extend(
            lab_records
        )

    return records


def generate_forward_zone(
    config,
    serial,
    records,
):
    dns = config["dns"]
    soa = dns["soa"]
    ns = dns["nameserver"]

    lines = [
        f"$TTL {dns['ttl']}",
        "",
        (
            "@       IN      SOA     "
            f"{soa['primary_ns']} "
            f"{soa['responsible']} ("
        ),
        (
            f"        {serial}      "
            "; Serial"
        ),
        (
            f"        {soa['refresh']}      "
            "; Refresh"
        ),
        (
            f"        {soa['retry']}       "
            "; Retry"
        ),
        (
            f"        {soa['expire']}     "
            "; Expire"
        ),
        (
            f"        {soa['negative_ttl']}       "
            "; Negative cache TTL"
        ),
        ")",
        "",
        (
            "@       IN      NS      "
            f"{soa['primary_ns']}"
        ),
        "",
        "; Authoritative DNS server",
        (
            f"{ns['name']}     "
            f"IN      A       "
            f"{ns['address']}"
        ),
        "",
        (
            "; ------------------------------------------------"
        ),
        "; AUTO-GENERATED LAB RECORDS",
        "; Do not edit manually.",
        (
            "; ------------------------------------------------"
        ),
    ]

    current_lab = None

    for record in records:

        if record["lab_key"] != current_lab:
            current_lab = record["lab_key"]

            lines.extend(
                [
                    "",
                    (
                        f"; Lab {record['lab_id']} - "
                        f"{record['lab_name']} - "
                        f"{record['subnet']}"
                    ),
                ]
            )

        owner = (
            f"{record['node_key']}."
            f"{record['lab_key']}"
        )

        lines.append(
            f"{owner:<28} "
            f"IN      A       "
            f"{record['ip']}"
        )

    lines.append("")

    return "\n".join(lines)


def generate_reverse_zone(
    config,
    serial,
    records,
):
    dns = config["dns"]
    soa = dns["soa"]
    reverse_zone = dns["reverse_zone"]

    lines = [
        f"$TTL {dns['ttl']}",
        "",
        (
            "@       IN      SOA     "
            f"{soa['primary_ns']} "
            f"{soa['responsible']} ("
        ),
        (
            f"        {serial}      "
            "; Serial"
        ),
        (
            f"        {soa['refresh']}      "
            "; Refresh"
        ),
        (
            f"        {soa['retry']}       "
            "; Retry"
        ),
        (
            f"        {soa['expire']}     "
            "; Expire"
        ),
        (
            f"        {soa['negative_ttl']}       "
            "; Negative cache TTL"
        ),
        ")",
        "",
        (
            "@       IN      NS      "
            f"{soa['primary_ns']}"
        ),
        "",
        (
            "; ------------------------------------------------"
        ),
        "; AUTO-GENERATED LAB RECORDS",
        "; Do not edit manually.",
        (
            "; ------------------------------------------------"
        ),
    ]

    current_lab = None

    for record in records:

        if record["lab_key"] != current_lab:
            current_lab = record["lab_key"]

            lines.extend(
                [
                    "",
                    (
                        f"; Lab {record['lab_id']} - "
                        f"{record['lab_name']} - "
                        f"{record['subnet']}"
                    ),
                ]
            )

        owner = reverse_owner_for_ip(
            record["ip"],
            reverse_zone,
        )

        fqdn = (
            f"{record['node_key']}."
            f"{record['lab_key']}."
            f"{dns['domain']}."
        )

        lines.append(
            f"{owner:<16} "
            f"IN      PTR     "
            f"{fqdn}"
        )

    lines.append("")

    return "\n".join(lines)


def validate_zone_text(
    zone_name,
    zone_text,
):
    temp_path = None

    try:
        with tempfile.NamedTemporaryFile(
            mode="w",
            prefix="labmgmt-zone-",
            suffix=".db",
            delete=False,
        ) as temp_file:

            temp_path = Path(
                temp_file.name
            )

            temp_file.write(
                zone_text
            )

            temp_file.flush()

        result = subprocess.run(
            [
                "named-checkzone",
                zone_name,
                str(temp_path),
            ],
            capture_output=True,
            text=True,
        )

    except FileNotFoundError:
        raise LabMgmtError(
            "named-checkzone is not installed"
        )

    finally:
        if temp_path is not None:
            try:
                temp_path.unlink(
                    missing_ok=True
                )
            except OSError:
                pass

    if result.returncode != 0:
        output = (
            result.stderr.strip()
            or result.stdout.strip()
        )

        raise LabMgmtError(
            f"Zone validation failed for "
            f"{zone_name}:\n{output}"
        )

    return result.stdout.strip()

def command_validate(args):
    config = load_yaml(
        CONFIG_FILE
    )

    registry = load_yaml(
        REGISTRY_FILE
    )

    validate_config(
        config
    )

    validate_dns_config(
        config
    )

    validate_registry(
        config,
        registry,
    )

    result = validate_ipam_state(
        config,
        registry,
    )

    print(
        "IPAM validation successful"
    )

    print(
        f"  Config:        "
        f"{CONFIG_FILE}"
    )

    print(
        f"  Registry:      "
        f"{REGISTRY_FILE}"
    )

    print(
        f"  Labs:          "
        f"{len(registry.get('labs', {}))}"
    )

    print(
        f"  Active nodes:  "
        f"{result['active_nodes']}"
    )

    print(
        f"  Retired nodes: "
        f"{result['retired_nodes']}"
    )

    print(
        "  DNS config:    valid"
    )

    if result["warnings"]:
        print()
        print("Warnings")
        print("--------")

        for warning in result["warnings"]:
            print(
                f"  {warning}"
            )

def resolve_topology_path(topology):
    config = load_yaml(
        CONFIG_FILE
    )

    labs_root = Path(
        config["labs_root"]
    ).expanduser()
    if not labs_root.is_absolute():
        labs_root = (REPO_ROOT / labs_root).resolve()

    topology_arg = Path(
        topology
    ).expanduser()

    #
    # Absolute path: use exactly what the user supplied.
    #
    if topology_arg.is_absolute():
        return topology_arg.resolve()

    #
    # First try the normal relative-path form:
    #
    #   Simple/Simple.clab.yml
    #
    candidate = (
        labs_root
        / topology_arg
    )

    if candidate.is_file():
        return candidate.resolve()

    #
    # If the argument resolves to a lab directory:
    #
    #   labmgmt apply Simple
    #
    # find the Containerlab topology inside it.
    #
    if candidate.is_dir():
        topology_files = sorted(
            list(candidate.glob("*.clab.yml"))
            + list(candidate.glob("*.clab.yaml"))
        )

        if len(topology_files) == 1:
            return topology_files[0].resolve()

        if len(topology_files) == 0:
            raise LabMgmtError(
                f"No Containerlab topology found in:\n"
                f"  {candidate}\n\n"
                f"Expected a file matching:\n"
                f"  *.clab.yml or *.clab.yaml"
            )

        choices = "\n".join(
            f"  {repo_relative(path)}"
            for path in topology_files
        )

        raise LabMgmtError(
            f"Multiple Containerlab topology files found "
            f"for lab '{topology_arg}':\n\n"
            f"{choices}\n\n"
            f"Specify the topology explicitly."
        )

    #
    # Nothing matched.
    #
    raise LabMgmtError(
        f"Topology or lab not found:\n"
        f"  {topology}\n\n"
        f"Looked under:\n"
        f"  {labs_root}"
    )

def command_show(args):
    config = load_yaml(CONFIG_FILE)
    registry = load_yaml(REGISTRY_FILE)

    validate_config(config)
    validate_registry(config, registry)

    topology_path = resolve_topology_path(
        args.topology
    )
    topo = parse_topology(topology_path)

    registry_entry = registry.get("labs", {}).get(topo["key"])

    print()
    print(f"Topology:       {topology_path}")
    print(f"Containerlab:   {topo['name']}")
    print(f"IPAM/DNS key:   {topo['key']}")
    print(f"Nodes:          {len(topo['nodes'])}")

    if registry_entry:
        lab_id = int(registry_entry["lab_id"])
        subnet = calculate_lab_subnet(config, lab_id)

        print("Registration:   existing")
        print(f"Lab ID:         {lab_id}")
        print(f"Subnet:         {subnet}")
        print(f"Status:         {registry_entry.get('status', 'unknown')}")
    else:
        lab_id = int(registry["allocation"]["next_lab_id"])
        subnet = calculate_lab_subnet(config, lab_id)

        print("Registration:   NEW / not registered")
        print(f"Next Lab ID:    {lab_id}")
        print(f"Would use:      {subnet}")

    print()
    print("Nodes")
    print("-----")

    node_start = int(config["management"]["node_addresses"]["first"])

    for offset, node in enumerate(topo["nodes"]):
        proposed_ip = subnet.network_address + node_start + offset

        print(f"{node['name']}")
        print(f"  key:          {node['key']}")
        print(f"  kind:         {node['kind'] or '-'}")
        print(f"  image:        {node['image'] or '-'}")

        if node["mgmt_ipv4"]:
            print(f"  topology IP:  {node['mgmt_ipv4']}")
        elif not registry_entry:
            print(f"  proposed IP:  {proposed_ip}")
        else:
            print("  topology IP:  not set")

        print(
            f"  DNS:          "
            f"{node['key']}.{topo['key']}."
            f"{config['dns']['domain']}"
        )

def command_register(args):
    config = load_yaml(CONFIG_FILE)
    registry = load_yaml(REGISTRY_FILE)

    validate_config(config)
    validate_registry(config, registry)

    topology_path = resolve_topology_path(
        args.topology
    )
    topo = parse_topology(topology_path)

    lab_key = topo["key"]

    # Refuse to accidentally register an existing lab again.
    if lab_key in registry.get("labs", {}):
        entry = registry["labs"][lab_key]

        raise LabMgmtError(
            f"Lab '{lab_key}' is already registered "
            f"with Lab ID {entry['lab_id']}"
        )

    lab_id_plan = plan_next_lab_id(
        config,
        registry,
    )

    lab_id = int(
        lab_id_plan["lab_id"]
    )

    subnet = calculate_lab_subnet(config, lab_id)

    first_node = int(
        config["management"]["node_addresses"]["first"]
    )

    last_node = int(
        config["management"]["node_addresses"]["last"]
    )

    node_count = len(topo["nodes"])

    if first_node + node_count - 1 > last_node:
        raise LabMgmtError(
            f"Topology contains {node_count} nodes, "
            "which exceeds the available node-address range"
        )

    destination = LABS_DIR / f"{lab_key}.yml"

    # An unregistered file with this name is suspicious.
    # Never overwrite it automatically.
    if destination.exists():
        raise LabMgmtError(
            f"IPAM file already exists but lab is not registered: "
            f"{destination}"
        )

    nodes = {}

    for offset, node in enumerate(topo["nodes"]):
        host_number = first_node + offset
        ip = subnet.network_address + host_number

        nodes[node["key"]] = {
            "name": node["name"],
            "ip": str(ip),
            "status": "active",
        }

    lab_data = {
        "version": 1,

        "lab": {
            "name": topo["name"],
            "key": lab_key,
            "lab_id": lab_id,
            "subnet": str(subnet),
            "topology": repo_relative(topology_path),
            "status": "active",
        },

        "allocation": {
            "next_node_address": first_node + node_count,
            "recycled_node_addresses": [],
        },

        "nodes": nodes,

        "history": {
            "recycled_nodes": [],
        },
    }

    print()
    print(f"Lab:            {topo['name']}")
    print(f"IPAM/DNS key:   {lab_key}")
    print(f"Lab ID:         {lab_id}")
    print(f"Subnet:         {subnet}")
    print(f"Topology:       {repo_relative(topology_path)}")
    print()
    print("Assignments")
    print("-----------")

    for node in topo["nodes"]:
        record = nodes[node["key"]]

        print(
            f"{node['name']:<15} "
            f"{record['ip']:<15} "
            f"{node['key']}.{lab_key}."
            f"{config['dns']['domain']}"
        )

    if args.dry_run:
        print()
        print("Dry run only; no files changed.")
        return

    registry.setdefault("labs", {})

    registry["labs"][lab_key] = {
        "lab_id": lab_id,
        "status": "active",
        "file": f"labs/{lab_key}.yml",
    }

    consume_lab_id(
        registry,
        lab_id_plan,
    )

    #
    # Write the lab file first.
    # If writing registry.yml then fails, remove the new lab file.
    #
    write_yaml_atomic(destination, lab_data)

    try:
        write_yaml_atomic(REGISTRY_FILE, registry)

    except Exception:
        try:
            destination.unlink(missing_ok=True)
        except OSError:
            pass

        raise

    print()
    print("Registration complete.")
    print(f"Created:  {destination}")
    print(f"Updated:  {REGISTRY_FILE}")
    print()
    print("Topology and BIND were NOT modified.")

def load_roundtrip_yaml(path):
    yaml_rt = YAML()
    yaml_rt.preserve_quotes = True
    yaml_rt.width = 4096

    try:
        with path.open("r") as f:
            data = yaml_rt.load(f)

    except Exception as exc:
        raise LabMgmtError(
            f"Unable to read topology {path}: {exc}"
        )

    if not isinstance(data, dict):
        raise LabMgmtError(
            f"Topology {path} does not contain a valid YAML mapping"
        )

    return data


def write_roundtrip_yaml_atomic(path, data):
    temp_path = path.with_name(
        f".{path.name}.tmp-{os.getpid()}"
    )

    yaml_rt = YAML()
    yaml_rt.preserve_quotes = True
    yaml_rt.width = 4096

    try:
        original_mode = path.stat().st_mode & 0o7777

        with temp_path.open("w") as f:
            yaml_rt.dump(data, f)
            f.flush()
            os.fsync(f.fileno())

        os.chmod(temp_path, original_mode)
        os.replace(temp_path, path)

    except Exception as exc:
        try:
            temp_path.unlink(missing_ok=True)
        except OSError:
            pass

        raise LabMgmtError(
            f"Unable to write topology {path}: {exc}"
        )


def write_bytes_atomic(path, content):
    temp_path = path.with_name(
        f".{path.name}.rollback-{os.getpid()}"
    )

    try:
        original_mode = path.stat().st_mode & 0o7777

        with temp_path.open("wb") as f:
            f.write(content)
            f.flush()
            os.fsync(f.fileno())

        os.chmod(temp_path, original_mode)
        os.replace(temp_path, path)

    except Exception as exc:
        try:
            temp_path.unlink(missing_ok=True)
        except OSError:
            pass

        raise LabMgmtError(
            f"Unable to restore {path}: {exc}"
        )


def build_updated_lab_data(plan):
    data = deepcopy(plan["lab_data"])
    topo = plan["topology"]

    #
    # Keep display information/path current.
    #
    data["lab"]["name"] = topo["name"]
    data["lab"]["topology"] = plan["topology_path"]

    #
    # Active/new/returning nodes.
    #
    for item in plan["assignments"]:
        node_key = item["key"]

        if item["action"] == "new":
            data["nodes"][node_key] = {
                "name": item["name"],
                "ip": item["ip"],
                "status": "active",
            }

        else:
            data["nodes"][node_key]["name"] = item["name"]
            data["nodes"][node_key]["status"] = "active"

    #
    # Nodes removed from the topology become retired.
    #
    for item in plan["retiring"]:
        data["nodes"][item["key"]]["status"] = "retired"

    #
    # Advance the allocator only if new addresses
    # were actually allocated.
    #
    if plan["new"]:
        data["allocation"]["next_node_address"] = (
            plan["resulting_next_node"]
        )

        data["allocation"]["recycled_node_addresses"] = (
            plan["remaining_recycled"]
        )

    return data


def build_updated_topology_data(config, plan, topology_path):
    data = load_roundtrip_yaml(topology_path)

    topo = plan["topology"]
    lab_data = plan["lab_data"]

    lab_key = topo["key"]
    lab_id = int(lab_data["lab"]["lab_id"])

    expected_network = management_network_name(
        config,
        lab_key,
    )

    expected_subnet = str(
        calculate_lab_subnet(
            config,
            lab_id,
        )
    )

    expected_gateway = str(
        calculate_lab_gateway(
            config,
            lab_id,
        )
    )

    #
    # Create the top-level mgmt section if necessary.
    # Put it immediately after "name:" when possible.
    #
    mgmt = data.get("mgmt")

    if mgmt is None:
        mgmt = CommentedMap()

        if isinstance(data, CommentedMap):
            keys = list(data.keys())

            if "name" in keys:
                position = keys.index("name") + 1
            else:
                position = 0

            data.insert(
                position,
                "mgmt",
                mgmt,
            )

        else:
            data["mgmt"] = mgmt

    elif not isinstance(mgmt, dict):
        raise LabMgmtError(
            "Topology contains an invalid top-level "
            "'mgmt:' section"
        )

    mgmt["network"] = expected_network
    mgmt["ipv4-subnet"] = expected_subnet
    mgmt["ipv4-gw"] = expected_gateway

    #
    # Locate topology nodes.
    #
    try:
        nodes = data["topology"]["nodes"]
    except (KeyError, TypeError):
        raise LabMgmtError(
            "Topology does not contain topology.nodes"
        )

    #
    # Apply IPAM-assigned addresses.
    #
    for item in plan["assignments"]:
        node_name = item["name"]
        expected_ip = item["ip"]

        if node_name not in nodes:
            raise LabMgmtError(
                f"Node '{node_name}' disappeared while "
                "preparing topology update"
            )

        node = nodes[node_name]

        if not isinstance(node, dict):
            raise LabMgmtError(
                f"Node '{node_name}' is not a valid mapping"
            )

        if "mgmt-ipv4" in node:
            node["mgmt-ipv4"] = expected_ip

        else:
            #
            # For readability, put mgmt-ipv4 just after image
            # when possible.
            #
            if isinstance(node, CommentedMap):
                keys = list(node.keys())

                if "image" in keys:
                    position = keys.index("image") + 1
                else:
                    position = len(keys)

                node.insert(
                    position,
                    "mgmt-ipv4",
                    expected_ip,
                )

            else:
                node["mgmt-ipv4"] = expected_ip

    return data


def verify_sync_result(config, registry, topology_path, lab_key):
    #
    # Revalidate all persistent IPAM.
    #
    validate_registry(config, registry)
    validate_ipam_state(config, registry)

    registry_entry = registry["labs"][lab_key]

    lab_file = (
        IPAM_DIR / registry_entry["file"]
    ).resolve()

    lab_data = load_yaml(lab_file)
    topo = parse_topology(topology_path)

    lab_id = int(lab_data["lab"]["lab_id"])

    expected_network = management_network_name(
        config,
        lab_key,
    )

    expected_subnet = str(
        calculate_lab_subnet(
            config,
            lab_id,
        )
    )

    expected_gateway = str(
        calculate_lab_gateway(
            config,
            lab_id,
        )
    )

    mgmt = topo["mgmt"]

    if mgmt.get("network") != expected_network:
        raise LabMgmtError(
            "Post-write verification failed: "
            "management network mismatch"
        )

    if str(mgmt.get("ipv4-subnet")) != expected_subnet:
        raise LabMgmtError(
            "Post-write verification failed: "
            "management subnet mismatch"
        )

    if str(mgmt.get("ipv4-gw")) != expected_gateway:
        raise LabMgmtError(
            "Post-write verification failed: "
            "management gateway mismatch"
        )

    topology_keys = {
        node["key"]
        for node in topo["nodes"]
    }

    active_ipam_keys = {
        key
        for key, value in lab_data["nodes"].items()
        if value["status"] == "active"
    }

    if topology_keys != active_ipam_keys:
        raise LabMgmtError(
            "Post-write verification failed: "
            "active IPAM nodes do not match topology nodes"
        )

    for node in topo["nodes"]:
        stored = lab_data["nodes"][node["key"]]

        topology_ip = normalize_mgmt_ipv4(
            node["mgmt_ipv4"]
        )

        if topology_ip != stored["ip"]:
            raise LabMgmtError(
                f"Post-write verification failed for "
                f"{node['name']}: topology has "
                f"{node['mgmt_ipv4']}, IPAM has "
                f"{stored['ip']}"
            )

def command_sync(args):
    config = load_yaml(CONFIG_FILE)
    registry = load_yaml(REGISTRY_FILE)

    validate_config(config)
    validate_registry(config, registry)

    #
    # Never reconcile against invalid persistent state.
    #
    validate_ipam_state(
        config,
        registry,
    )

    topology_path = resolve_topology_path(
        args.topology
    )

    plan = build_sync_plan(
        config,
        registry,
        topology_path,
    )

    topo = plan["topology"]
    lab_data = plan["lab_data"]

    lab_key = topo["key"]

    lab_id = int(
        lab_data["lab"]["lab_id"]
    )

    expected_network = management_network_name(
        config,
        lab_key,
    )

    expected_subnet = str(
        calculate_lab_subnet(
            config,
            lab_id,
        )
    )

    expected_gateway = str(
        calculate_lab_gateway(
            config,
            lab_id,
        )
    )

    current_mgmt = topo["mgmt"]

    management_changes = 0

    print()
    print(
        "SYNC DRY RUN"
        if args.dry_run
        else "SYNC"
    )
    print("=" * (12 if args.dry_run else 4))
    print()

    print(f"Lab:            {topo['name']}")
    print(f"IPAM/DNS key:   {lab_key}")
    print(f"Lab ID:         {lab_id}")
    print(
        f"Subnet:         "
        f"{lab_data['lab']['subnet']}"
    )
    print(
        f"Topology:       "
        f"{plan['topology_path']}"
    )
    print(
        f"IPAM file:      "
        f"{repo_relative(plan['lab_file'])}"
    )

    #
    # Lab display name change.
    #
    lab_name_changed = (
        lab_data["lab"].get("name")
        != topo["name"]
    )

    if lab_name_changed:
        print()
        print("Lab name change:")
        print(
            f"  stored:       "
            f"{lab_data['lab'].get('name')}"
        )
        print(
            f"  current:      "
            f"{topo['name']}"
        )

    #
    # Topology path change.
    #
    if plan["topology_path_changed"]:
        print()
        print("Topology path change:")
        print(
            f"  stored:       "
            f"{plan['stored_topology_path']}"
        )
        print(
            f"  current:      "
            f"{plan['topology_path']}"
        )

    #
    # Management network.
    #
    print()
    print("Management network")
    print("------------------")

    current_network = current_mgmt.get("network")

    if current_network == expected_network:
        print(
            f"Network:         "
            f"{expected_network} (matches)"
        )
    else:
        print(
            f"Network:         "
            f"{current_network or 'not set'} "
            f"-> {expected_network}"
        )
        management_changes += 1

    current_subnet = current_mgmt.get("ipv4-subnet")

    if str(current_subnet) == expected_subnet:
        print(
            f"IPv4 subnet:     "
            f"{expected_subnet} (matches)"
        )
    else:
        print(
            f"IPv4 subnet:     "
            f"{current_subnet or 'not set'} "
            f"-> {expected_subnet}"
        )
        management_changes += 1

    current_gateway = current_mgmt.get("ipv4-gw")

    if str(current_gateway) == expected_gateway:
        print(
            f"IPv4 gateway:    "
            f"{expected_gateway} (matches)"
        )
    else:
        print(
            f"IPv4 gateway:    "
            f"{current_gateway or 'not set'} "
            f"-> {expected_gateway}"
        )
        management_changes += 1

    #
    # Reconciliation summary.
    #
    print()
    print("Summary")
    print("-------")

    print(
        f"Unchanged:      "
        f"{len(plan['unchanged'])}"
    )
    print(
        f"Returning:      "
        f"{len(plan['returning'])}"
    )
    print(
        f"New:            "
        f"{len(plan['new'])}"
    )
    print(
        f"Retiring:       "
        f"{len(plan['retiring'])}"
    )
    print(
        f"Already retired: "
        f"{len(plan['already_retired'])}"
    )

    #
    # Node comparisons.
    #
    print()
    print("Topology nodes")
    print("--------------")

    dns_domain = config["dns"]["domain"]

    topology_changes = 0

    for item in plan["assignments"]:
        node = item["topology_node"]
        expected_ip = item["ip"]

        raw_topology_ip = node.get(
            "mgmt_ipv4"
        )

        normalized_topology_ip = (
            normalize_mgmt_ipv4(
                raw_topology_ip
            )
        )

        if raw_topology_ip is None:
            topology_state = (
                f"missing -> would set {expected_ip}"
            )
            topology_changes += 1

        elif normalized_topology_ip is None:
            topology_state = (
                f"INVALID '{raw_topology_ip}' "
                f"-> would set {expected_ip}"
            )
            topology_changes += 1

        elif normalized_topology_ip != expected_ip:
            topology_state = (
                f"{raw_topology_ip} "
                f"-> would set {expected_ip}"
            )
            topology_changes += 1

        else:
            topology_state = "matches IPAM"

        print()
        print(f"{item['name']}")
        print(
            f"  status:       "
            f"{item['action']}"
        )
        print(
            f"  IPAM IP:      "
            f"{expected_ip}"
        )
        print(
            f"  topology IP:  "
            f"{topology_state}"
        )
        print(
            f"  DNS:          "
            f"{item['key']}."
            f"{lab_key}."
            f"{dns_domain}"
        )

        if item.get("name_changed"):
            print(
                f"  name:         "
                f"{item['stored_name']} "
                f"-> {item['name']}"
            )

    if plan["retiring"]:
        print()
        print("Nodes that would be retired")
        print("---------------------------")

        for item in plan["retiring"]:
            print(
                f"{item['name']:<15} "
                f"{item['ip']}"
            )

    if plan["new"]:
        print()
        print("New allocations")
        print("---------------")

        for item in plan["new"]:
            print(
                f"{item['name']:<15} "
                f"{item['ip']}"
            )

    if plan["returning"]:
        print()
        print("Returning nodes")
        print("---------------")

        for item in plan["returning"]:
            print(
                f"{item['name']:<15} "
                f"{item['ip']} "
                "(original address restored)"
            )

    #
    # Calculate change counts.
    #
    ipam_changes = (
        len(plan["new"])
        + len(plan["returning"])
        + len(plan["retiring"])
    )

    if plan["topology_path_changed"]:
        ipam_changes += 1

    if lab_name_changed:
        ipam_changes += 1

    if any(
        item.get("name_changed")
        for item in plan["assignments"]
    ):
        ipam_changes += 1

    total_topology_changes = (
        management_changes
        + topology_changes
    )

    print()
    print("Planned changes")
    print("---------------")

    print(
        f"IPAM changes:       "
        f"{'yes' if ipam_changes else 'no'}"
    )
    print(
        f"Mgmt settings:      "
        f"{management_changes}"
    )
    print(
        f"Node mgmt IPs:      "
        f"{topology_changes}"
    )
    print(
        f"Topology changes:   "
        f"{total_topology_changes}"
    )
    print("DNS changes:        not evaluated yet")
    print("BIND reload:        no")

    #
    # Dry-run ends here.
    #
    if args.dry_run:
        print()
        print("Dry run only; no files changed.")
        return

    #
    # Nothing to do.
    #
    if (
        not ipam_changes
        and total_topology_changes == 0
    ):
        print()
        print("Already synchronized; no files changed.")
        return

    #
    # Construct both updated files completely in memory
    # before touching disk.
    #
    updated_lab_data = build_updated_lab_data(
        plan
    )

    updated_topology_data = (
        build_updated_topology_data(
            config,
            plan,
            topology_path,
        )
    )

    #
    # Save exact originals for automatic rollback.
    #
    original_lab_bytes = (
        plan["lab_file"].read_bytes()
    )

    original_topology_bytes = (
        topology_path.read_bytes()
    )

    wrote_lab = False
    wrote_topology = False

    try:
        if ipam_changes:
            write_yaml_atomic(
                plan["lab_file"],
                updated_lab_data,
            )
            wrote_lab = True

        if total_topology_changes:
            write_roundtrip_yaml_atomic(
                topology_path,
                updated_topology_data,
            )
            wrote_topology = True

        #
        # Verify the files we just wrote.
        #
        verify_sync_result(
            config,
            registry,
            topology_path,
            lab_key,
        )

    except Exception as exc:
        print()
        print(
            "Sync failed; restoring original files..."
        )

        rollback_errors = []

        if wrote_lab:
            try:
                write_bytes_atomic(
                    plan["lab_file"],
                    original_lab_bytes,
                )
            except Exception as rollback_exc:
                rollback_errors.append(
                    str(rollback_exc)
                )

        if wrote_topology:
            try:
                write_bytes_atomic(
                    topology_path,
                    original_topology_bytes,
                )
            except Exception as rollback_exc:
                rollback_errors.append(
                    str(rollback_exc)
                )

        if rollback_errors:
            raise LabMgmtError(
                f"Sync failed: {exc}. "
                f"Rollback also encountered errors: "
                f"{'; '.join(rollback_errors)}"
            )

        raise LabMgmtError(
            f"Sync failed and changes were rolled back: "
            f"{exc}"
        )

    print()
    print("Sync complete.")

    if wrote_lab:
        print(
            f"Updated IPAM:    "
            f"{repo_relative(plan['lab_file'])}"
        )

    if wrote_topology:
        print(
            f"Updated topology:"
            f" {repo_relative(topology_path)}"
        )

    print()
    print("DNS and BIND were NOT modified.")

def write_text_atomic(path, content):
    path.parent.mkdir(
        parents=True,
        exist_ok=True,
    )

    temp_path = path.with_name(
        f".{path.name}.tmp-{os.getpid()}"
    )

    try:
        with temp_path.open(
            "w",
            encoding="utf-8",
            newline="\n",
        ) as f:
            f.write(content)
            f.flush()
            os.fsync(f.fileno())

        os.chmod(
            temp_path,
            0o644,
        )

        os.replace(
            temp_path,
            path,
        )

    except Exception as exc:
        try:
            temp_path.unlink(
                missing_ok=True
            )
        except OSError:
            pass

        raise LabMgmtError(
            f"Unable to write {path}: {exc}"
        )


def validate_zone_file(
    zone_name,
    path,
):
    try:
        result = subprocess.run(
            [
                "named-checkzone",
                zone_name,
                str(path),
            ],
            capture_output=True,
            text=True,
        )

    except FileNotFoundError:
        raise LabMgmtError(
            "named-checkzone is not installed"
        )

    if result.returncode != 0:
        output = (
            result.stderr.strip()
            or result.stdout.strip()
        )

        raise LabMgmtError(
            f"Zone validation failed for "
            f"{zone_name}:\n{output}"
        )

    return result.stdout.strip()

def command_dns(args):
    config = load_yaml(
        CONFIG_FILE
    )

    registry = load_yaml(
        REGISTRY_FILE
    )

    validate_config(
        config
    )

    validate_dns_config(
        config
    )

    validate_registry(
        config,
        registry,
    )

    validate_ipam_state(
        config,
        registry,
    )

    #
    # INSTALL MODE
    #
    if args.action == "install":

        if args.dry_run:
            raise LabMgmtError(
                "--dry-run cannot be combined "
                "with 'dns install'"
            )

        install_dns_zones(
            config,
            registry,
        )

        return

    #
    # GENERATE / DRY-RUN MODE
    #
    serials = calculate_next_dns_serial(
        config
    )

    records = collect_dns_records(
        config,
        registry,
    )

    forward_text = generate_forward_zone(
        config,
        serials["new"],
        records,
    )

    reverse_text = generate_reverse_zone(
        config,
        serials["new"],
        records,
    )

    validate_zone_text(
        config["dns"]["domain"],
        forward_text,
    )

    validate_zone_text(
        config["dns"]["reverse_zone"],
        reverse_text,
    )

    print()
    print(
        "DNS DRY RUN"
        if args.dry_run
        else "DNS GENERATION"
    )

    print(
        "=" * (
            11
            if args.dry_run
            else 14
        )
    )

    print()
    print("Serials")
    print("-------")

    print(
        f"Current forward: "
        f"{serials['forward']}"
    )

    print(
        f"Current reverse: "
        f"{serials['reverse']}"
    )

    print(
        f"Proposed serial: "
        f"{serials['new']}"
    )

    print()
    print("Records")
    print("-------")

    print(
        f"Active A records:   "
        f"{len(records)}"
    )

    print(
        f"Active PTR records: "
        f"{len(records)}"
    )

    print()
    print("Validation")
    print("----------")

    print("Forward zone: OK")
    print("Reverse zone: OK")

    if args.dry_run:
        print()
        print(
            "Forward zone "
            f"({config['dns']['domain']})"
        )

        print(
            "=" * (
                len(
                    config["dns"]["domain"]
                )
                + 15
            )
        )

        print(
            forward_text,
            end="",
        )

        print()
        print(
            "Reverse zone "
            f"({config['dns']['reverse_zone']})"
        )

        print(
            "=" * (
                len(
                    config["dns"][
                        "reverse_zone"
                    ]
                )
                + 15
            )
        )

        print(
            reverse_text,
            end="",
        )

        print()
        print(
            "Dry run only; no files "
            "were changed."
        )

        return

    #
    # Normal-user generation of Git-managed
    # staging files.
    #
    write_text_atomic(
        GENERATED_FORWARD_ZONE,
        forward_text,
    )

    write_text_atomic(
        GENERATED_REVERSE_ZONE,
        reverse_text,
    )

    validate_zone_file(
        config["dns"]["domain"],
        GENERATED_FORWARD_ZONE,
    )

    validate_zone_file(
        config["dns"]["reverse_zone"],
        GENERATED_REVERSE_ZONE,
    )

    print()
    print("Generated files")
    print("---------------")

    print(
        f"Forward: "
        f"{GENERATED_FORWARD_ZONE}"
    )

    print(
        f"Reverse: "
        f"{GENERATED_REVERSE_ZONE}"
    )

    print()
    print(
        "BIND live zone files were NOT modified."
    )

    print(
        "Run the following after inspection:"
    )

    print()
    print(
        "  sudo labmgmt dns install"
    )

def is_junos_node(node):
    return node.get("kind", "") in JUNOS_KINDS


def junos_saved_config_backup_dir(topology_path, node):
    return (
        topology_path.parent
        / "configs"
        / "junos"
        / node["name"]
    )


def junos_connection_details(node):
    host = normalize_mgmt_ipv4(
        node.get("mgmt_ipv4")
    )

    if not host:
        raise LabMgmtError(
            f"Node '{node['name']}' does not have a valid "
            "mgmt-ipv4 address in the topology"
        )

    username = os.environ.get(
        "LABMGMT_JUNOS_USERNAME",
        JUNOS_DEFAULT_USERNAME,
    )

    password = os.environ.get(
        "LABMGMT_JUNOS_PASSWORD",
        JUNOS_DEFAULT_PASSWORD,
    )

    if not password:
        raise LabMgmtError(
            "Junos automation requires LABMGMT_JUNOS_PASSWORD "
            "to be set in the local environment"
        )

    return host, username, password


def junos_ssh_options():
    #
    # Containerlab VMs are disposable and commonly get new SSH host keys
    # after a destroy/redeploy.  Do not persist those keys in the lab
    # server's known_hosts file.
    #
    # Junos JSSH commonly authenticates the Containerlab admin account via
    # keyboard-interactive even though it also advertises password auth.
    # Match the known-good interactive OpenSSH/SCP path instead of trying
    # plain password authentication first.
    #
    options = [
        "-o", "ConnectTimeout=10",
        "-o", "StrictHostKeyChecking=no",
        "-o", "UserKnownHostsFile=/dev/null",
        "-o", "PreferredAuthentications=keyboard-interactive",
        "-o", "KbdInteractiveAuthentication=yes",
        "-o", "PasswordAuthentication=no",
        "-o", "PubkeyAuthentication=no",
        "-o", "BatchMode=no",
        "-o", "NumberOfPasswordPrompts=1",
    ]

    debug = os.environ.get(
        "LABMGMT_SSH_DEBUG",
        "",
    ).strip().lower() in {"1", "true", "yes", "on"}

    if debug:
        options.extend(["-o", "LogLevel=DEBUG1"])
    else:
        options.extend(["-o", "LogLevel=ERROR"])

    return options


def run_ssh_family(command, password, timeout=90):
    """
    Run OpenSSH ssh/scp through a controlling pseudo-terminal.

    Junos JSSH commonly presents the Containerlab admin password as a
    keyboard-interactive prompt.  OpenSSH reads that prompt from its
    controlling terminal (/dev/tty), not merely from stdin.  ``pty.fork``
    gives the child a real controlling PTY, allowing labmgmt to answer the
    password challenge exactly as an interactive user would.

    This intentionally avoids Paramiko/SFTP, sshpass, SSH_ASKPASS, and
    non-interactive Junos exec channels.
    """

    executable = command[0]

    if shutil.which(executable) is None:
        raise LabMgmtError(
            f"Required command '{executable}' was not found"
        )

    debug = os.environ.get(
        "LABMGMT_SSH_DEBUG",
        "",
    ).strip().lower() in {"1", "true", "yes", "on"}

    if debug:
        print(
            "LABMGMT SSH DEBUG command: " + " ".join(command),
            file=sys.stderr,
        )

    # pty.fork() is deliberate here.  Unlike merely wiring Popen's
    # stdin/stdout/stderr to a PTY, it makes the PTY the child's controlling
    # terminal.  OpenSSH keyboard-interactive authentication therefore uses
    # this PTY instead of the user's real terminal.
    pid, master_fd = pty.fork()

    if pid == 0:
        try:
            os.execvpe(
                executable,
                command,
                os.environ.copy(),
            )
        except Exception as exc:
            os.write(
                2,
                f"Unable to execute {executable}: {exc}\n".encode(
                    "utf-8", errors="replace"
                ),
            )
            os._exit(127)

    output = bytearray()
    prompt_tail = bytearray()
    password_prompts = 0
    start_time = time.monotonic()
    child_status = None

    try:
        while True:
            elapsed = time.monotonic() - start_time
            remaining = timeout - elapsed

            if remaining <= 0:
                try:
                    os.kill(pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                try:
                    os.waitpid(pid, 0)
                except ChildProcessError:
                    pass
                raise LabMgmtError(
                    f"{executable} timed out after {timeout} seconds"
                )

            readable, _, _ = select.select(
                [master_fd],
                [],
                [],
                min(0.25, remaining),
            )

            if readable:
                try:
                    chunk = os.read(master_fd, 4096)
                except OSError as exc:
                    # Linux PTYs normally return EIO after the child has
                    # closed the slave side.
                    if exc.errno == errno.EIO:
                        chunk = b""
                    else:
                        raise

                if chunk:
                    output.extend(chunk)
                    prompt_tail.extend(chunk)

                    if len(prompt_tail) > 4096:
                        del prompt_tail[:-4096]

                    if debug:
                        sys.stderr.write(
                            chunk.decode("utf-8", errors="replace")
                        )
                        sys.stderr.flush()

                    # Junos/JSSH normally emits "(user@host) Password:".
                    # Be deliberately tolerant of CR/LF and terminal escape
                    # sequences/chatter immediately before the prompt.
                    tail_text = prompt_tail.decode(
                        "utf-8", errors="ignore"
                    ).lower()

                    if "password:" in tail_text:
                        if password_prompts >= 1:
                            try:
                                os.kill(pid, signal.SIGKILL)
                            except ProcessLookupError:
                                pass
                            try:
                                os.waitpid(pid, 0)
                            except ChildProcessError:
                                pass
                            raise LabMgmtError(
                                "SSH authentication failed after a repeated "
                                "password prompt"
                            )

                        os.write(
                            master_fd,
                            (password + "\n").encode("utf-8"),
                        )
                        password_prompts += 1
                        prompt_tail.clear()

            # Poll child status without blocking.
            try:
                waited_pid, status = os.waitpid(pid, os.WNOHANG)
            except ChildProcessError:
                waited_pid, status = pid, 0

            if waited_pid == pid:
                child_status = status

                # Drain any final terminal output.
                while True:
                    try:
                        readable, _, _ = select.select(
                            [master_fd], [], [], 0
                        )
                        if not readable:
                            break
                        chunk = os.read(master_fd, 4096)
                        if not chunk:
                            break
                        output.extend(chunk)
                        if debug:
                            sys.stderr.write(
                                chunk.decode(
                                    "utf-8", errors="replace"
                                )
                            )
                            sys.stderr.flush()
                    except OSError as exc:
                        if exc.errno == errno.EIO:
                            break
                        raise
                break

    finally:
        try:
            os.close(master_fd)
        except OSError:
            pass

    if child_status is None:
        try:
            _, child_status = os.waitpid(pid, 0)
        except ChildProcessError:
            child_status = 0

    returncode = os.waitstatus_to_exitcode(child_status)

    text_output = output.decode(
        "utf-8",
        errors="replace",
    )

    return subprocess.CompletedProcess(
        args=command,
        returncode=returncode,
        stdout="",
        stderr=text_output,
    )

def format_process_error(result, fallback):
    output = (
        result.stderr.strip()
        or result.stdout.strip()
    )

    if output:
        return output

    return fallback


def scp_remote_source(node):
    host, username, _ = junos_connection_details(
        node
    )

    return (
        f"{username}@{host}:"
        f"{JUNOS_SAVED_CONFIG_DIR}"
    )


def scp_remote_home(node):
    host, username, _ = junos_connection_details(
        node
    )

    return f"{username}@{host}:."


def junos_scp_pull_directory(node, destination):
    _, _, password = junos_connection_details(
        node
    )

    command = [
        "scp",
        # OpenSSH 9+ uses SFTP by default.  -O explicitly selects the
        # original SCP protocol, which works with Junos even when the
        # Junos SFTP subsystem is disabled.
        "-O",
        "-r",
        *junos_ssh_options(),
        scp_remote_source(node),
        str(destination),
    ]

    return run_ssh_family(
        command,
        password,
        timeout=90,
    )


def junos_scp_push_directory(node, local_configs_dir):
    _, _, password = junos_connection_details(
        node
    )

    command = [
        "scp",
        "-O",
        "-r",
        *junos_ssh_options(),
        str(local_configs_dir),
        scp_remote_home(node),
    ]

    return run_ssh_family(
        command,
        password,
        timeout=90,
    )


def junos_scp_create_config_dir(node):
    """Create ~/configs using legacy SCP only.

    This intentionally avoids a non-interactive SSH exec channel because
    Junos JSSH can close those channels even when interactive SSH and
    legacy SCP work normally.
    """

    with tempfile.TemporaryDirectory(
        prefix=f".{node['name']}.mkdir-"
    ) as temp_parent_name:
        temp_parent = Path(temp_parent_name)
        staged_configs = temp_parent / JUNOS_SAVED_CONFIG_DIR
        staged_configs.mkdir(parents=True, exist_ok=True)

        result = junos_scp_push_directory(
            node,
            staged_configs,
        )

    return result


def scp_channel_closed(result):
    output = (
        (result.stdout or "")
        + "\n"
        + (result.stderr or "")
    ).lower()

    return "channel closed" in output


def scp_source_missing(result):
    output = (
        (result.stdout or "")
        + "\n"
        + (result.stderr or "")
    ).lower()

    return (
        "no such file" in output
        or "not found" in output
    )


def replace_directory_atomic(source, destination):
    source = Path(source)
    destination = Path(destination)

    destination.parent.mkdir(
        parents=True,
        exist_ok=True,
    )

    old_path = destination.with_name(
        f".{destination.name}.old-{os.getpid()}"
    )

    try:
        if old_path.exists():
            shutil.rmtree(old_path)

        if destination.exists():
            destination.rename(old_path)

        source.rename(destination)

        if old_path.exists():
            shutil.rmtree(old_path)

    except Exception:
        if not destination.exists() and old_path.exists():
            old_path.rename(destination)
        raise


def backup_junos_saved_configs(
    topology_path,
    node,
    dry_run=False,
):
    target_dir = junos_saved_config_backup_dir(
        topology_path,
        node,
    )

    # Pull the complete remote configs directory with legacy SCP.  Use a
    # temporary local parent so the existing known-good backup is not
    # touched unless the transfer succeeds completely.
    if dry_run:
        temp_parent_context = tempfile.TemporaryDirectory(
            prefix=f".{node['name']}.scp-"
        )
    else:
        temp_parent_base = target_dir.parent
        temp_parent_base.mkdir(
            parents=True,
            exist_ok=True,
        )
        temp_parent_context = tempfile.TemporaryDirectory(
            prefix=f".{node['name']}.scp-",
            dir=str(temp_parent_base),
        )

    with temp_parent_context as temp_parent_name:
        temp_parent = Path(temp_parent_name)

        result = junos_scp_pull_directory(
            node,
            temp_parent,
        )

        created = False

        if result.returncode != 0:
            # A fresh Junos node may not have ~/configs yet.  Legacy SCP
            # can report either "No such file" or merely "Channel closed"
            # for a missing source directory.  For a real save, create the
            # directory using SCP itself and retry.  This avoids Junos JSSH
            # non-interactive exec channels entirely.
            if scp_source_missing(result) or scp_channel_closed(result):
                if dry_run:
                    return {
                        "created": True,
                        "files": [],
                        "target": target_dir,
                    }

                create_result = junos_scp_create_config_dir(node)

                if create_result.returncode != 0:
                    detail = format_process_error(
                        create_result,
                        "no diagnostic output returned by SCP",
                    )
                    raise LabMgmtError(
                        f"Unable to create remote directory "
                        f"{JUNOS_SAVED_CONFIG_DIR} with SCP: {detail}"
                    )

                created = True

                result = junos_scp_pull_directory(
                    node,
                    temp_parent,
                )

            if result.returncode != 0:
                detail = format_process_error(
                    result,
                    "no diagnostic output returned by SCP",
                )
                raise LabMgmtError(
                    f"Unable to copy {JUNOS_SAVED_CONFIG_DIR} from "
                    f"{node['name']} with SCP: {detail}"
                )

        pulled_dir = (
            temp_parent
            / Path(JUNOS_SAVED_CONFIG_DIR).name
        )

        if not pulled_dir.exists():
            raise LabMgmtError(
                "SCP completed but the expected copied directory "
                f"'{pulled_dir.name}' was not created"
            )

        files = local_saved_config_files(
            pulled_dir
        )

        if dry_run:
            return {
                "created": created,
                "files": files,
                "target": target_dir,
            }

        if not files:
            (pulled_dir / ".gitkeep").touch()

        replace_directory_atomic(
            pulled_dir,
            target_dir,
        )

        return {
            "created": created,
            "files": files,
            "target": target_dir,
        }

def local_saved_config_files(target_dir):
    target_dir = Path(target_dir)

    if not target_dir.exists():
        return []

    return sorted(
        [
            path.relative_to(target_dir)
            for path in target_dir.rglob("*")
            if (
                path.is_file()
                and path.name != ".gitkeep"
            )
        ],
        key=lambda value: value.as_posix(),
    )


def restore_junos_saved_configs(
    topology_path,
    node,
    dry_run=False,
):
    source_dir = junos_saved_config_backup_dir(
        topology_path,
        node,
    )

    files = local_saved_config_files(
        source_dir
    )

    if dry_run:
        return {
            "files": files,
            "source": source_dir,
        }

    # Stage a directory literally named "configs" and push it to the
    # Junos user's home directory with legacy SCP.  SCP creates ~/configs
    # when it does not exist, so no separate SSH command channel is needed.
    with tempfile.TemporaryDirectory(
        prefix=f".{node['name']}.restore-"
    ) as temp_parent_name:
        temp_parent = Path(temp_parent_name)
        staged_configs = (
            temp_parent
            / Path(JUNOS_SAVED_CONFIG_DIR).name
        )

        staged_configs.mkdir(
            parents=True,
            exist_ok=True,
        )

        for relative_path in files:
            source_path = source_dir / relative_path
            destination_path = (
                staged_configs / relative_path
            )

            destination_path.parent.mkdir(
                parents=True,
                exist_ok=True,
            )

            shutil.copy2(
                source_path,
                destination_path,
            )

        result = junos_scp_push_directory(
            node,
            staged_configs,
        )

        if result.returncode != 0:
            detail = format_process_error(
                result,
                "no diagnostic output returned by SCP",
            )
            raise LabMgmtError(
                f"Unable to restore {JUNOS_SAVED_CONFIG_DIR} to "
                f"{node['name']} with SCP: {detail}"
            )

    return {
        "files": files,
        "source": source_dir,
    }

def command_restore(args):
    topology_path = resolve_topology_path(
        args.topology
    )

    topo = parse_topology(
        topology_path
    )

    lab_name = topo["name"]

    junos_nodes = [
        node
        for node in topo["nodes"]
        if is_junos_node(node)
    ]

    if args.node:
        matches = [
            node
            for node in junos_nodes
            if node["name"] == args.node
        ]

        if not matches:
            raise LabMgmtError(
                f"Junos node '{args.node}' was not found "
                f"in lab '{lab_name}'"
            )

        junos_nodes = matches

    print()
    print(
        "================================================"
    )

    if args.dry_run:
        print("LAB RESTORE - DRY RUN")
    else:
        print("LAB RESTORE")

    print(
        "================================================"
    )

    print()
    print(f"Lab:       {lab_name}")
    print(
        f"Topology:  {repo_relative(topology_path)}"
    )
    print()
    print("Junos saved configurations:")

    failures = []

    if not junos_nodes:
        print("  No supported Junos nodes found.")

    for node in junos_nodes:
        node_name = node["name"]

        print()
        print(f"  {node_name}:")

        try:
            result = restore_junos_saved_configs(
                topology_path,
                node,
                dry_run=args.dry_run,
            )

        except Exception as exc:
            failures.append(
                (node_name, str(exc))
            )
            print(f"    FAILED - {exc}")
            continue

        files = result["files"]
        source = result["source"]

        if args.dry_run:
            print(
                f"    Would ensure "
                f"{JUNOS_SAVED_CONFIG_DIR} exists"
            )
        else:
            print(
                f"    Ensured "
                f"{JUNOS_SAVED_CONFIG_DIR} exists"
            )

        if not files:
            print(
                "    No saved configuration files "
                "to restore."
            )
            continue

        action = (
            "Would restore"
            if args.dry_run
            else "Restored"
        )

        print(
            f"    {action} {len(files)} file(s) "
            f"from {repo_relative(source)}:"
        )

        for relative_path in files:
            print(
                f"      {relative_path.as_posix()}"
            )

    print()
    print(
        "================================================"
    )
    print("RESTORE RESULTS")
    print(
        "================================================"
    )
    print()

    if failures:
        for name, reason in failures:
            first_line = (
                reason.splitlines()[0]
                if reason
                else "unknown error"
            )
            print(
                f"FAILED: {name}: {first_line}"
            )

        raise LabMgmtError(
            f"Lab restore completed with "
            f"{len(failures)} failure(s)"
        )

    if args.dry_run:
        print(
            "Dry run completed successfully."
        )
    else:
        print(
            "Lab restore completed successfully."
        )


def ensure_lab_directories(
    topology_path,
    dry_run=False,
):
    """
    Ensure persistent per-lab directories exist.

    These directories belong to the lab repository,
    not Containerlab's generated clab-<lab> directory.
    """

    lab_dir = topology_path.parent

    directories = (
        lab_dir / "configs",
        lab_dir / "pcaps",
    )

    for directory in directories:
        if dry_run:
            if directory.exists():
                print(
                    f"Persistent directory exists: "
                    f"{repo_relative(directory)}"
                )
            else:
                print(
                    f"Would create persistent directory: "
                    f"{repo_relative(directory)}"
                )

            continue

        directory.mkdir(
            parents=True,
            exist_ok=True,
        )

        #
        # Keep the directory in Git even while empty.
        #
        gitkeep = directory / ".gitkeep"

        if not gitkeep.exists():
            gitkeep.touch()

def command_save(args):
    topology_path = resolve_topology_path(
        args.topology
    )

    topo = parse_topology(
        topology_path
    )

    lab_name = topo["name"]

    labhost_nodes = []
    junos_nodes = []

    for node in topo["nodes"]:
        image = str(
            node.get("image") or ""
        )

        if image.startswith("labhost:"):
            labhost_nodes.append(
                node
            )

        if is_junos_node(node):
            junos_nodes.append(
                node
            )

    #
    # Optional single-node mode.
    #
    if args.node:
        topology_matches = [
            node
            for node in topo["nodes"]
            if node["name"] == args.node
        ]

        if not topology_matches:
            raise LabMgmtError(
                f"Node '{args.node}' was not found "
                f"in lab '{lab_name}'"
            )

        selected = topology_matches[0]

        labhost_nodes = [
            node
            for node in labhost_nodes
            if node["name"] == args.node
        ]

        junos_nodes = [
            node
            for node in junos_nodes
            if node["name"] == args.node
        ]

        if not labhost_nodes and not junos_nodes:
            raise LabMgmtError(
                f"Node '{selected['name']}' is not a "
                "supported labhost or Junos node"
            )

    print()
    print(
        "================================================"
    )

    if args.dry_run:
        print("LAB SAVE - DRY RUN")
    else:
        print("LAB SAVE")

    print(
        "================================================"
    )

    print()
    print(
        f"Lab:       {lab_name}"
    )

    print(
        f"Topology:  {repo_relative(topology_path)}"
    )

    failures = []

    #
    # Containerlab save is lab-wide.
    #
    # When --node is used, skip it because Containerlab
    # save would affect the entire lab.
    #
    if args.node:
        print()
        print("Containerlab:")
        print(
            "  skipped "
            "(--node requested)"
        )

    elif args.dry_run:
        print()
        print("Containerlab:")
        print("  Would run:")
        print(
            f"    containerlab save "
            f"-t {topology_path}"
        )

    else:
        print()
        print("Containerlab:")
        print(
            "  Saving supported network-device "
            "configurations..."
        )

        try:
            result = subprocess.run(
                [
                    "containerlab",
                    "save",
                    "-t",
                    str(topology_path),
                ],
                text=True,
                capture_output=True,
                check=False,
            )

        except FileNotFoundError:
            failures.append(
                (
                    "Containerlab",
                    "containerlab command not found",
                )
            )

            print(
                "  FAILED - containerlab command "
                "not found"
            )

        else:
            if result.returncode == 0:
                print("  OK")

                if result.stdout.strip():
                    print()

                    for line in (
                        result.stdout
                        .strip()
                        .splitlines()
                    ):
                        print(
                            f"    {line}"
                        )

            else:
                failures.append(
                    (
                        "Containerlab",
                        (
                            result.stderr.strip()
                            or result.stdout.strip()
                            or (
                                "containerlab save "
                                f"returned {result.returncode}"
                            )
                        ),
                    )
                )

                print("  FAILED")

                output = (
                    result.stderr.strip()
                    or result.stdout.strip()
                )

                if output:
                    for line in output.splitlines():
                        print(
                            f"    {line}"
                        )

    #
    # Save manually named Junos configuration files.
    #
    print()
    print("Junos saved configurations:")

    if not junos_nodes:
        print(
            "  No supported Junos nodes found."
        )

    for node in junos_nodes:
        node_name = node["name"]

        print()
        print(
            f"  {node_name}:"
        )

        try:
            result = backup_junos_saved_configs(
                topology_path,
                node,
                dry_run=args.dry_run,
            )

        except Exception as exc:
            failures.append(
                (node_name, str(exc))
            )
            print(
                f"    FAILED - {exc}"
            )
            continue

        if result["created"]:
            if args.dry_run:
                print(
                    f"    Would create "
                    f"{JUNOS_SAVED_CONFIG_DIR}"
                )
            else:
                print(
                    f"    Created "
                    f"{JUNOS_SAVED_CONFIG_DIR}"
                )

        files = result["files"]
        target = result["target"]

        if not files:
            if args.dry_run:
                print(
                    "    No saved configuration files found."
                )
            else:
                print(
                    f"    No saved configuration files found; "
                    f"preserved empty directory at "
                    f"{repo_relative(target)}"
                )
            continue

        action = (
            "Would back up"
            if args.dry_run
            else "Backed up"
        )

        print(
            f"    {action} {len(files)} file(s) to "
            f"{repo_relative(target)}:"
        )

        for relative_path in files:
            print(
                f"      {relative_path.as_posix()}"
            )

    #
    # Save labhost state.
    #
    print()
    print("labhost:")

    if not labhost_nodes:
        print(
            "  No labhost nodes found."
        )

    for node in labhost_nodes:
        node_name = node["name"]

        container_name = (
            f"clab-{lab_name}-{node_name}"
        )

        command = [
            "docker",
            "exec",
            "-u",
            "lab",
            container_name,
            "lab-save",
        ]

        if args.dry_run:
            command.append(
                "--dry-run"
            )

        print()
        print(
            f"  {node_name}:"
        )

        try:
            result = subprocess.run(
                command,
                text=True,
                capture_output=True,
                check=False,
            )

        except FileNotFoundError:
            failures.append(
                (
                    node_name,
                    "docker command not found",
                )
            )

            print(
                "    FAILED - docker command "
                "not found"
            )

            continue

        if result.returncode == 0:
            if args.dry_run:
                print(
                    "    Preview:"
                )

                output = (
                    result.stdout.rstrip()
                )

                if output:
                    for line in output.splitlines():
                        print(
                            f"      {line}"
                        )
                else:
                    print(
                        "      no configuration "
                        "generated"
                    )

            else:
                print(
                    "    OK"
                )

                output = (
                    result.stdout.strip()
                )

                if output:
                    for line in output.splitlines():
                        print(
                            f"      {line}"
                        )

        else:
            output = (
                result.stderr.strip()
                or result.stdout.strip()
                or (
                    f"docker exec returned "
                    f"{result.returncode}"
                )
            )

            failures.append(
                (
                    node_name,
                    output,
                )
            )

            print(
                "    FAILED"
            )

            for line in output.splitlines():
                print(
                    f"      {line}"
                )

    print()
    print(
        "================================================"
    )
    print("SAVE RESULTS")
    print(
        "================================================"
    )

    if failures:
        print()

        for name, reason in failures:
            first_line = (
                reason.splitlines()[0]
                if reason
                else "unknown error"
            )

            print(
                f"FAILED: {name}: {first_line}"
            )

        raise LabMgmtError(
            f"Lab save completed with "
            f"{len(failures)} failure(s)"
        )

    print()

    if args.dry_run:
        print(
            "Dry run completed successfully."
        )
    else:
        print(
            "Lab save completed successfully."
        )

def command_apply(args):
    topology_path = resolve_topology_path(
        args.topology
    )

    #
    # Confirm that this topology belongs to a
    # registered lab before doing anything.
    #
    config = load_yaml(
        CONFIG_FILE
    )

    registry = load_yaml(
        REGISTRY_FILE
    )

    validate_config(
        config
    )

    validate_dns_config(
        config
    )

    validate_registry(
        config,
        registry,
    )

    validate_ipam_state(
        config,
        registry,
    )

    topo = parse_topology(
        topology_path
    )

    lab_key = topo["key"]

    if lab_key not in registry.get("labs", {}):
        raise LabMgmtError(
            f"Lab '{topo['name']}' is not registered.\n"
            f"Register it first with:\n"
            f"  labmgmt register {lab_key}"
        )

    #
    # Dry-run path.
    #
    if args.dry_run:
        print()
        print(
            "================================================"
        )
        print("LAB APPLY - DRY RUN")
        print(
            "================================================"
        )

        print()
        print(
            "================================================"
        )
        print("PERSISTENT LAB DIRECTORIES")
        print(
            "================================================"
        )

        ensure_lab_directories(
            topology_path,
            dry_run=True,
        )

        #
        # Existing sync dry-run.
        #
        sync_args = argparse.Namespace(
            topology=str(topology_path),
            dry_run=True,
        )

        command_sync(
            sync_args
        )

        print()
        print(
            "================================================"
        )
        print("DNS PREVIEW")
        print(
            "================================================"
        )

        #
        # Existing DNS dry-run.
        #
        dns_args = argparse.Namespace(
            action="generate",
            dry_run=True,
        )

        command_dns(
            dns_args
        )

        #
        # Nexus dry-run preview.
        #
        lab_file = (
            LABS_DIR
            / f"{lab_key}.yml"
        )

        lab_data = load_yaml(
            lab_file
        )

        nexus_rows, nexus_skipped = (
            build_nexus_inventory(
                topo,
                lab_data,
            )
        )

        print_nexus_summary(
            lab_key,
            nexus_rows,
            nexus_skipped,
        )

        print()
        print(
            "Dry run only; Nexus CSV was not written."
        )

        return

    #
    # Real apply path.
    #
    print()
    print(
        "================================================"
    )
    print("LAB APPLY")
    print(
        "================================================"
    )

    print()
    print(
        "Preparing persistent lab directories..."
    )

    ensure_lab_directories(
        topology_path,
        dry_run=False,
    )

    #
    # First synchronize persistent IPAM and topology.
    #
    sync_args = argparse.Namespace(
        topology=str(topology_path),
        dry_run=False,
    )

    command_sync(
        sync_args
    )

    #
    # Re-read/validate state after sync before
    # generating DNS and Nexus inventory.
    #
    config = load_yaml(
        CONFIG_FILE
    )

    registry = load_yaml(
        REGISTRY_FILE
    )

    validate_config(
        config
    )

    validate_dns_config(
        config
    )

    validate_registry(
        config,
        registry,
    )

    validate_ipam_state(
        config,
        registry,
    )

    #
    # Generate the Git-managed DNS staging files.
    #
    dns_args = argparse.Namespace(
        action="generate",
        dry_run=False,
    )

    command_dns(
        dns_args
    )

    #
    # Generate Nexus Terminal inventory.
    #
    lab_file = (
        LABS_DIR
        / f"{lab_key}.yml"
    )

    lab_data = load_yaml(
        lab_file
    )

    nexus_rows, nexus_skipped = (
        build_nexus_inventory(
            topo,
            lab_data,
        )
    )

    nexus_file = write_nexus_csv(
        topology_path,
        topo,
        nexus_rows,
    )

    print_nexus_summary(
        lab_key,
        nexus_rows,
        nexus_skipped,
    )

    print()
    print(
        f"Generated:  {nexus_file}"
    )

    #
    # Final summary.
    #
    print()
    print(
        "================================================"
    )
    print("APPLY COMPLETE")
    print(
        "================================================"
    )

    print()
    print(
        f"Lab:       {topo['name']}"
    )

    print(
        f"Topology:  {repo_relative(topology_path)}"
    )

    print()
    print(
        "IPAM and topology are synchronized."
    )

    print(
        "DNS staging files are generated and validated."
    )

    print(
        "Nexus Terminal inventory is generated."
    )

    print()
    print(
        "To publish DNS:"
    )

    print()
    print(
        "  sudo labmgmt dns install"
    )

def command_onboard(args):
    topology_path = resolve_topology_path(
        args.topology
    )
    config = load_yaml(
        CONFIG_FILE
    )

    registry = load_yaml(
        REGISTRY_FILE
    )

    #
    # Validate everything before allocating anything.
    #
    validate_config(
        config
    )

    validate_dns_config(
        config
    )

    validate_registry(
        config,
        registry,
    )

    validate_ipam_state(
        config,
        registry,
    )

    topo = parse_topology(
        topology_path
    )

    lab_key = topo["key"]

    #
    # Onboard is only for new labs.
    #
    if lab_key in registry.get("labs", {}):
        entry = registry["labs"][lab_key]

        raise LabMgmtError(
            f"Lab '{topo['name']}' is already registered "
            f"as Lab ID {entry['lab_id']}.\n"
            f"Use:\n"
            f"  labmgmt apply "
            f"{repo_relative(topology_path)}"
        )

    #
    # First show exactly what registration would do.
    #
    print()
    print(
        "================================================"
    )
    print("NEW LAB ONBOARDING")
    print(
        "================================================"
    )

    register_preview_args = argparse.Namespace(
        topology=str(topology_path),
        dry_run=True,
    )

    command_register(
        register_preview_args
    )

    #
    # Dry-run stops before consuming the Lab ID.
    #
    if args.dry_run:
        print()
        print(
            "Onboarding dry run complete; "
            "no files changed."
        )
        return

    #
    # Explicit confirmation protects against typos
    # in the topology's top-level name.
    #
    if not args.yes:
        if not sys.stdin.isatty():
            raise LabMgmtError(
                "Confirmation is required for onboarding.\n"
                "Run interactively or use --yes."
            )

        lab_id_plan = plan_next_lab_id(
            config,
            registry,
        )

        next_lab_id = int(
            lab_id_plan["lab_id"]
        )

        subnet = calculate_lab_subnet(
            config,
            next_lab_id,
        )

        print()
        answer = input(
            f"Register '{topo['name']}' as Lab ID "
            f"{next_lab_id} ({subnet})? [y/N]: "
        ).strip().lower()

        if answer not in (
            "y",
            "yes",
        ):
            print()
            print(
                "Onboarding cancelled; "
                "no Lab ID was allocated."
            )
            return

    #
    # Persist the new Lab ID and node allocations.
    #
    register_args = argparse.Namespace(
        topology=str(topology_path),
        dry_run=False,
    )

    command_register(
        register_args
    )

    #
    # Now synchronize the topology and generate
    # the Git-managed DNS staging files.
    #
    try:
        apply_args = argparse.Namespace(
            topology=str(topology_path),
            dry_run=False,
        )

        command_apply(
            apply_args
        )

    except Exception as exc:
        #
        # Deliberately keep the registration.
        #
        # Once a Lab ID has been allocated, we do not
        # silently give it back. The user can fix the
        # problem and simply rerun labmgmt apply.
        #
        raise LabMgmtError(
            f"Lab registration succeeded, but apply failed.\n"
            f"The Lab ID remains reserved intentionally.\n"
            f"Fix the reported problem and run:\n"
            f"  labmgmt apply "
            f"{repo_relative(topology_path)}\n\n"
            f"Original error: {exc}"
        )

    print()
    print(
        "================================================"
    )
    print("ONBOARDING COMPLETE")
    print(
        "================================================"
    )

    print()
    print(
        f"Lab:       {topo['name']}"
    )

    refreshed_registry = load_yaml(
        REGISTRY_FILE
    )

    entry = refreshed_registry[
        "labs"
    ][lab_key]

    print(
        f"Lab ID:    {entry['lab_id']}"
    )

    print(
        f"Topology:  {repo_relative(topology_path)}"
    )

    print()
    print(
        "The lab is registered, IPAM/topology "
        "are synchronized, and DNS is staged."
    )

    print()
    print(
        "Publish DNS with:"
    )

    print()
    print(
        "  sudo labmgmt dns install"
    )

def command_recycle_node(args):
    config = load_yaml(
        CONFIG_FILE
    )

    registry = load_yaml(
        REGISTRY_FILE
    )

    validate_config(
        config
    )

    validate_registry(
        config,
        registry,
    )

    validate_ipam_state(
        config,
        registry,
    )

    lab_key = canonical_name(
        args.lab
    )

    node_key = canonical_name(
        args.node
    )

    #
    # Locate the lab.
    #
    registry_entry = (
        registry
        .get("labs", {})
        .get(lab_key)
    )

    if registry_entry is None:
        raise LabMgmtError(
            f"Lab '{args.lab}' is not registered"
        )

    lab_file = (
        IPAM_DIR
        / registry_entry["file"]
    ).resolve()

    lab_data = load_yaml(
        lab_file
    )

    #
    # Locate the node.
    #
    node = (
        lab_data
        .get("nodes", {})
        .get(node_key)
    )

    if node is None:
        raise LabMgmtError(
            f"Node '{args.node}' does not exist "
            f"in lab '{lab_key}'"
        )

    #
    # Only retired nodes can be recycled.
    #
    if node.get("status") != "retired":
        raise LabMgmtError(
            f"Node '{node['name']}' is currently "
            f"'{node.get('status')}'.\n"
            "Only retired nodes can be recycled.\n"
            "Remove the node from the topology and "
            "run 'labmgmt apply' first."
        )

    subnet = ipaddress.ip_network(
        lab_data["lab"]["subnet"]
    )

    address = ipaddress.ip_address(
        node["ip"]
    )

    host_number = (
        int(address)
        - int(subnet.network_address)
    )

    recycled = [
        int(value)
        for value in (
            lab_data["allocation"]
            .get(
                "recycled_node_addresses",
                [],
            )
        )
    ]

    if host_number in recycled:
        raise LabMgmtError(
            f"Address {address} is already "
            "marked as recycled"
        )

    print()
    print("RECYCLE NODE")
    print("============")
    print()

    print(
        f"Lab:          "
        f"{lab_data['lab']['name']}"
    )

    print(
        f"Node:         "
        f"{node['name']}"
    )

    print(
        f"IP address:   "
        f"{address}"
    )

    print(
        f"Host number:  "
        f".{host_number}"
    )

    print(
        f"Status:       "
        f"{node['status']}"
    )

    print()
    print(
        "Recycling will permanently remove this "
        "node's IPAM identity."
    )

    print(
        f"{address} will become eligible for "
        "future reuse."
    )

    print()
    print(
        "Normal allocation will still continue "
        "from the high-water mark first."
    )

    if args.dry_run:
        print()
        print(
            "Dry run only; no files changed."
        )
        return

    #
    # Require confirmation unless --yes was used.
    #
    if not args.yes:
        if not sys.stdin.isatty():
            raise LabMgmtError(
                "Confirmation is required.\n"
                "Run interactively or use --yes."
            )

        answer = input(
            f"Recycle {node['name']} "
            f"({address})? [y/N]: "
        ).strip().lower()

        if answer not in (
            "y",
            "yes",
        ):
            print()
            print(
                "Recycle cancelled; "
                "no files changed."
            )
            return

    #
    # Build the updated file in memory.
    #
    updated = deepcopy(
        lab_data
    )

    recycled = [
        int(value)
        for value in (
            updated["allocation"]
            .get(
                "recycled_node_addresses",
                [],
            )
        )
    ]

    recycled.append(
        host_number
    )

    recycled = sorted(
        set(recycled)
    )

    updated["allocation"][
        "recycled_node_addresses"
    ] = recycled

    #
    # Preserve an audit trail.
    #
    history = updated.setdefault(
        "history",
        {}
    )

    recycled_history = history.setdefault(
        "recycled_nodes",
        []
    )

    recycled_history.append(
        {
            "key": node_key,
            "name": node["name"],
            "ip": str(address),
            "recycled_at": (
                datetime.datetime.now(
                    datetime.timezone.utc
                )
                .isoformat(
                    timespec="seconds"
                )
                .replace(
                    "+00:00",
                    "Z",
                )
            ),
        }
    )

    #
    # Remove the node from persistent allocation
    # state. From this point onward, its old identity
    # is only retained in history.
    #
    del updated["nodes"][
        node_key
    ]

    #
    # Save exact original for rollback.
    #
    original_bytes = (
        lab_file.read_bytes()
    )

    try:
        write_yaml_atomic(
            lab_file,
            updated,
        )

        #
        # Verify the resulting IPAM state.
        #
        validate_ipam_state(
            config,
            registry,
        )

    except Exception as exc:
        try:
            write_bytes_atomic(
                lab_file,
                original_bytes,
            )
        except Exception as rollback_exc:
            raise LabMgmtError(
                f"Node recycle failed: {exc}\n"
                f"Rollback also failed: "
                f"{rollback_exc}"
            )

        raise LabMgmtError(
            f"Node recycle failed and was "
            f"rolled back: {exc}"
        )

    print()
    print("Node recycled successfully.")
    print()

    print(
        f"Released address: "
        f"{address}"
    )

    print(
        f"Reusable host:    "
        f".{host_number}"
    )

    print()
    print(
        "No DNS update is required because "
        "the node was already retired."
    )

def command_retire_lab(args):
    config = load_yaml(CONFIG_FILE)
    registry = load_yaml(REGISTRY_FILE)

    validate_config(config)
    validate_dns_config(config)
    validate_registry(config, registry)
    validate_ipam_state(config, registry)

    lab_key = canonical_name(args.lab)

    registry_entry = (
        registry.get("labs", {}).get(lab_key)
    )

    if registry_entry is None:
        raise LabMgmtError(
            f"Lab '{args.lab}' is not registered"
        )

    lab_file = (
        IPAM_DIR / registry_entry["file"]
    ).resolve()

    lab_data = load_yaml(lab_file)

    if registry_entry.get("status") == "retired":
        print()
        print(
            f"Lab '{lab_data['lab']['name']}' "
            "is already retired."
        )
        return

    active_nodes = [
        node
        for node in lab_data["nodes"].values()
        if node.get("status") == "active"
    ]

    retired_nodes = [
        node
        for node in lab_data["nodes"].values()
        if node.get("status") == "retired"
    ]

    print()
    print("RETIRE LAB")
    print("==========")
    print()

    print(
        f"Lab:           {lab_data['lab']['name']}"
    )
    print(
        f"Lab ID:        {lab_data['lab']['lab_id']}"
    )
    print(
        f"Subnet:        {lab_data['lab']['subnet']}"
    )
    print(
        f"Topology:      {lab_data['lab']['topology']}"
    )
    print(
        f"Active nodes:  {len(active_nodes)}"
    )
    print(
        f"Retired nodes: {len(retired_nodes)}"
    )

    print()
    print(
        "The Lab ID, subnet, and all node IPs "
        "will remain reserved."
    )
    print(
        "The lab and its nodes will be removed "
        "from generated DNS."
    )

    if args.dry_run:
        print()
        print(
            "Dry run only; no files changed."
        )
        return

    if not args.yes:
        if not sys.stdin.isatty():
            raise LabMgmtError(
                "Confirmation is required.\n"
                "Run interactively or use --yes."
            )

        answer = input(
            f"Retire '{lab_data['lab']['name']}'? "
            "[y/N]: "
        ).strip().lower()

        if answer not in ("y", "yes"):
            print()
            print(
                "Retirement cancelled; "
                "no files changed."
            )
            return

    updated_registry = deepcopy(registry)
    updated_lab = deepcopy(lab_data)

    updated_registry["labs"][
        lab_key
    ]["status"] = "retired"

    updated_lab["lab"]["status"] = "retired"

    for node in updated_lab["nodes"].values():
        if node.get("status") == "active":
            node["status"] = "retired"

    original_registry = REGISTRY_FILE.read_bytes()
    original_lab = lab_file.read_bytes()

    wrote_registry = False
    wrote_lab = False

    try:
        write_yaml_atomic(
            lab_file,
            updated_lab,
        )
        wrote_lab = True

        write_yaml_atomic(
            REGISTRY_FILE,
            updated_registry,
        )
        wrote_registry = True

        validate_registry(
            config,
            updated_registry,
        )

        validate_ipam_state(
            config,
            updated_registry,
        )

    except Exception as exc:
        rollback_errors = []

        if wrote_lab:
            try:
                write_bytes_atomic(
                    lab_file,
                    original_lab,
                )
            except Exception as rollback_exc:
                rollback_errors.append(
                    f"lab file: {rollback_exc}"
                )

        if wrote_registry:
            try:
                write_bytes_atomic(
                    REGISTRY_FILE,
                    original_registry,
                )
            except Exception as rollback_exc:
                rollback_errors.append(
                    f"registry: {rollback_exc}"
                )

        if rollback_errors:
            raise LabMgmtError(
                f"Lab retirement failed: {exc}\n"
                "Rollback also encountered errors:\n"
                + "\n".join(
                    f"  {error}"
                    for error in rollback_errors
                )
            )

        raise LabMgmtError(
            f"Lab retirement failed and was "
            f"rolled back: {exc}"
        )

    print()
    print("Lab retired successfully.")
    print()
    print(
        f"Reserved Lab ID: {lab_data['lab']['lab_id']}"
    )
    print(
        f"Reserved subnet: {lab_data['lab']['subnet']}"
    )

    #
    # Stage DNS automatically.
    #
    try:
        dns_args = argparse.Namespace(
            action="generate",
            dry_run=False,
        )

        command_dns(dns_args)

    except Exception as exc:
        raise LabMgmtError(
            "Lab retirement succeeded, but DNS "
            "staging failed.\n"
            "The retirement remains in effect.\n"
            "Fix the DNS issue and run:\n"
            "  labmgmt dns\n\n"
            f"Original error: {exc}"
        )

    print()
    print(
        "Publish the DNS removal with:"
    )
    print()
    print(
        "  sudo labmgmt dns install"
    )

def command_reactivate_lab(args):
    topology_path = resolve_topology_path(
        args.topology
    )
    config = load_yaml(CONFIG_FILE)
    registry = load_yaml(REGISTRY_FILE)

    validate_config(config)
    validate_dns_config(config)
    validate_registry(config, registry)
    validate_ipam_state(config, registry)

    topo = parse_topology(topology_path)
    lab_key = topo["key"]

    registry_entry = (
        registry.get("labs", {}).get(lab_key)
    )

    if registry_entry is None:
        raise LabMgmtError(
            f"Lab '{topo['name']}' is not registered"
        )

    lab_file = (
        IPAM_DIR / registry_entry["file"]
    ).resolve()

    lab_data = load_yaml(lab_file)

    if registry_entry.get("status") == "active":
        raise LabMgmtError(
            f"Lab '{topo['name']}' is already active.\n"
            "Use 'labmgmt apply' instead."
        )

    print()
    print("REACTIVATE LAB")
    print("==============")
    print()

    print(
        f"Lab:       {lab_data['lab']['name']}"
    )
    print(
        f"Lab ID:    {lab_data['lab']['lab_id']}"
    )
    print(
        f"Subnet:    {lab_data['lab']['subnet']}"
    )
    print(
        f"Topology:  {repo_relative(topology_path)}"
    )

    print()
    print(
        "Previously retired nodes present in the "
        "topology will regain their original IPs."
    )

    if args.dry_run:
        print()
        print(
            "Dry run only; no files changed."
        )
        return

    if not args.yes:
        if not sys.stdin.isatty():
            raise LabMgmtError(
                "Confirmation is required.\n"
                "Run interactively or use --yes."
            )

        answer = input(
            f"Reactivate '{lab_data['lab']['name']}'? "
            "[y/N]: "
        ).strip().lower()

        if answer not in ("y", "yes"):
            print()
            print(
                "Reactivation cancelled; "
                "no files changed."
            )
            return

    updated_registry = deepcopy(registry)
    updated_lab = deepcopy(lab_data)

    updated_registry["labs"][
        lab_key
    ]["status"] = "active"

    updated_lab["lab"]["status"] = "active"

    original_registry = REGISTRY_FILE.read_bytes()
    original_lab = lab_file.read_bytes()

    wrote_registry = False
    wrote_lab = False

    try:
        write_yaml_atomic(
            lab_file,
            updated_lab,
        )
        wrote_lab = True

        write_yaml_atomic(
            REGISTRY_FILE,
            updated_registry,
        )
        wrote_registry = True

        validate_registry(
            config,
            updated_registry,
        )

        validate_ipam_state(
            config,
            updated_registry,
        )

    except Exception as exc:
        rollback_errors = []

        if wrote_lab:
            try:
                write_bytes_atomic(
                    lab_file,
                    original_lab,
                )
            except Exception as rollback_exc:
                rollback_errors.append(
                    f"lab file: {rollback_exc}"
                )

        if wrote_registry:
            try:
                write_bytes_atomic(
                    REGISTRY_FILE,
                    original_registry,
                )
            except Exception as rollback_exc:
                rollback_errors.append(
                    f"registry: {rollback_exc}"
                )

        if rollback_errors:
            raise LabMgmtError(
                f"Reactivation failed: {exc}\n"
                "Rollback also encountered errors:\n"
                + "\n".join(
                    f"  {error}"
                    for error in rollback_errors
                )
            )

        raise LabMgmtError(
            f"Reactivation failed and was "
            f"rolled back: {exc}"
        )

    #
    # Now reconcile preserved node identities against
    # the current topology and stage DNS.
    #
    try:
        apply_args = argparse.Namespace(
            topology=str(topology_path),
            dry_run=False,
        )

        command_apply(apply_args)

    except Exception as exc:
        raise LabMgmtError(
            "The lab was reactivated, but apply failed.\n"
            "The lab remains active intentionally.\n"
            "Fix the problem and run:\n"
            f"  labmgmt apply "
            f"{repo_relative(topology_path)}\n\n"
            f"Original error: {exc}"
        )

    print()
    print("Lab reactivated successfully.")
    print()
    print(
        "Publish DNS with:"
    )
    print()
    print(
        "  sudo labmgmt dns install"
    )

def command_recycle_lab(args):
    config = load_yaml(
        CONFIG_FILE
    )

    registry = load_yaml(
        REGISTRY_FILE
    )

    validate_config(
        config
    )

    validate_dns_config(
        config
    )

    validate_registry(
        config,
        registry,
    )

    validate_ipam_state(
        config,
        registry,
    )

    lab_key = canonical_name(
        args.lab
    )

    registry_entry = (
        registry
        .get("labs", {})
        .get(lab_key)
    )

    if registry_entry is None:
        raise LabMgmtError(
            f"Lab '{args.lab}' is not registered"
        )

    #
    # Recycling is ONLY legal after retirement.
    #
    if registry_entry.get("status") != "retired":
        raise LabMgmtError(
            f"Lab '{args.lab}' is currently "
            f"'{registry_entry.get('status')}'.\n"
            "Only retired labs can be recycled.\n"
            "Retire it first with:\n"
            f"  labmgmt retire-lab {lab_key}"
        )

    lab_file = (
        IPAM_DIR
        / registry_entry["file"]
    ).resolve()

    lab_data = load_yaml(
        lab_file
    )

    if lab_data["lab"].get("status") != "retired":
        raise LabMgmtError(
            f"Lab '{lab_key}' is retired in the "
            "registry but not in its IPAM file"
        )

    lab_id = int(
        lab_data["lab"]["lab_id"]
    )

    subnet = lab_data["lab"]["subnet"]

    node_count = len(
        lab_data.get("nodes", {})
    )

    timestamp = (
        datetime.datetime.now(
            datetime.timezone.utc
        )
        .strftime(
            "%Y%m%dT%H%M%SZ"
        )
    )

    archive_name = (
        f"{lab_key}."
        f"lab-{lab_id}."
        f"{timestamp}.yml"
    )

    archive_file = (
        IPAM_ARCHIVE_DIR
        / archive_name
    )

    print()
    print("RECYCLE LAB")
    print("===========")
    print()

    print(
        f"Lab:             "
        f"{lab_data['lab']['name']}"
    )

    print(
        f"Lab ID:          "
        f"{lab_id}"
    )

    print(
        f"Subnet:          "
        f"{subnet}"
    )

    print(
        f"Reserved nodes:  "
        f"{node_count}"
    )

    print(
        f"Current IPAM:    "
        f"{repo_relative(lab_file)}"
    )

    print(
        f"Archive:         "
        f"{repo_relative(archive_file)}"
    )

    print()
    print(
        "This is a destructive IPAM operation."
    )

    print(
        "The lab's persistent identity will be "
        "removed from the active registry."
    )

    print(
        f"Lab ID {lab_id} will become eligible "
        "for future reuse."
    )

    print()
    print(
        "The complete lab IPAM file will be "
        "archived first."
    )

    if args.dry_run:
        print()
        print(
            "Dry run only; no files changed."
        )
        return

    if not args.yes:
        if not sys.stdin.isatty():
            raise LabMgmtError(
                "Confirmation is required.\n"
                "Run interactively or use --yes."
            )

        print()
        answer = input(
            f"PERMANENTLY recycle "
            f"'{lab_data['lab']['name']}' "
            f"(Lab ID {lab_id})? [y/N]: "
        ).strip().lower()

        if answer not in (
            "y",
            "yes",
        ):
            print()
            print(
                "Recycle cancelled; "
                "no files changed."
            )
            return

    #
    # Preserve exact originals for rollback.
    #
    original_registry = (
        REGISTRY_FILE.read_bytes()
    )

    original_lab = (
        lab_file.read_bytes()
    )

    updated_registry = deepcopy(
        registry
    )

    #
    # Remove the active registry entry.
    #
    del updated_registry[
        "labs"
    ][lab_key]

    #
    # Add Lab ID to the reusable pool.
    #
    recycled = [
        int(value)
        for value in (
            updated_registry[
                "allocation"
            ].get(
                "recycled_lab_ids",
                [],
            )
        )
    ]

    if lab_id in recycled:
        raise LabMgmtError(
            f"Lab ID {lab_id} is already "
            "in recycled_lab_ids"
        )

    recycled.append(
        lab_id
    )

    updated_registry[
        "allocation"
    ][
        "recycled_lab_ids"
    ] = sorted(
        set(recycled)
    )

    #
    # Keep a global audit trail.
    #
    history = (
        updated_registry
        .setdefault(
            "history",
            {},
        )
    )

    recycled_history = (
        history.setdefault(
            "recycled_labs",
            [],
        )
    )

    recycled_history.append(
        {
            "key": lab_key,
            "name": (
                lab_data["lab"]["name"]
            ),
            "lab_id": lab_id,
            "subnet": subnet,
            "topology": (
                lab_data["lab"].get(
                    "topology"
                )
            ),
            "archive": (
                repo_relative(
                    archive_file
                )
            ),
            "recycled_at": (
                datetime.datetime.now(
                    datetime.timezone.utc
                )
                .isoformat(
                    timespec="seconds"
                )
                .replace(
                    "+00:00",
                    "Z",
                )
            ),
        }
    )

    archive_created = False
    registry_written = False
    lab_removed = False

    try:
        #
        # 1. Archive first.
        #
        write_bytes_atomic_create(
            archive_file,
            original_lab,
            mode=0o644,
        )

        archive_created = True

        #
        # 2. Update registry.
        #
        write_yaml_atomic(
            REGISTRY_FILE,
            updated_registry,
        )

        registry_written = True

        #
        # 3. Remove active per-lab IPAM file.
        #
        lab_file.unlink()

        lab_removed = True

        #
        # 4. Validate resulting global state.
        #
        validate_registry(
            config,
            updated_registry,
        )

        validate_ipam_state(
            config,
            updated_registry,
        )

    except Exception as exc:
        rollback_errors = []

        #
        # Restore active lab file if it was removed.
        #
        if lab_removed:
            try:
                write_bytes_atomic_create(
                    lab_file,
                    original_lab,
                    mode=0o644,
                )
            except Exception as rollback_exc:
                rollback_errors.append(
                    f"lab file restore: "
                    f"{rollback_exc}"
                )

        #
        # Restore original registry.
        #
        if registry_written:
            try:
                write_bytes_atomic_create(
                    REGISTRY_FILE,
                    original_registry,
                    mode=0o644,
                )
            except Exception as rollback_exc:
                rollback_errors.append(
                    f"registry restore: "
                    f"{rollback_exc}"
                )

        #
        # Remove archive created by the failed
        # transaction.
        #
        if archive_created:
            try:
                archive_file.unlink(
                    missing_ok=True
                )
            except OSError as rollback_exc:
                rollback_errors.append(
                    f"archive cleanup: "
                    f"{rollback_exc}"
                )

        if rollback_errors:
            raise LabMgmtError(
                f"Lab recycle failed: {exc}\n"
                "Rollback also encountered errors:\n"
                + "\n".join(
                    f"  {error}"
                    for error
                    in rollback_errors
                )
            )

        raise LabMgmtError(
            f"Lab recycle failed and was "
            f"rolled back: {exc}"
        )

    print()
    print(
        "Lab recycled successfully."
    )

    print()
    print(
        f"Released Lab ID: "
        f"{lab_id}"
    )

    print(
        f"Released subnet: "
        f"{subnet}"
    )

    print(
        f"Archived IPAM:   "
        f"{repo_relative(archive_file)}"
    )

    print()
    print(
        "The Lab ID is now available in the "
        "recycled pool."
    )

    print(
        "Normal allocation will continue using "
        "never-before-used Lab IDs first."
    )

    print()
    print(
        "No DNS change is required because "
        "the lab was already retired."
    )

# ---------------------------------------------------------------------------
# Link control
# ---------------------------------------------------------------------------

LABMGMT_LINK_STATE_DIR = (
    Path.home()
    / ".cache"
    / "labmgmt"
    / "link-state"
)

QEMU_LINK_HELPER = r"""
import ctypes
import os
import re
import select
import socket
import subprocess
import sys
import time

mac = sys.argv[1].lower()
desired = sys.argv[2].lower()

if desired not in ("on", "off"):
    raise SystemExit("desired state must be on or off")

def endpoint_port(value):
    try:
        return int(value.rsplit(":", 1)[1], 16)
    except Exception:
        return None


def process_argv(pid):
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as handle:
            raw = handle.read()
    except OSError:
        return []

    return [
        part.decode(errors="replace")
        for part in raw.split(b"\0")
        if part
    ]


def process_socket_fds(pid):
    sockets = {}
    fd_dir = f"/proc/{pid}/fd"

    try:
        fd_names = os.listdir(fd_dir)
    except OSError:
        return sockets

    for fd_name in fd_names:
        if not fd_name.isdigit():
            continue

        try:
            target = os.readlink(f"{fd_dir}/{fd_name}")
        except OSError:
            continue

        match = re.fullmatch(r"socket:\[(\d+)\]", target)

        if match:
            sockets[match.group(1)] = int(fd_name)

    return sockets


def process_monitor_fd(pid):
    socket_fds = process_socket_fds(pid)

    if not socket_fds:
        return None

    for table_name in ("tcp", "tcp6"):
        table_path = f"/proc/{pid}/net/{table_name}"

        try:
            with open(table_path, "r", encoding="utf-8") as handle:
                lines = handle.readlines()[1:]
        except OSError:
            continue

        for line in lines:
            fields = line.split()

            if len(fields) < 10:
                continue

            local_addr = fields[1]
            remote_addr = fields[2]
            state = fields[3]
            inode = fields[9]

            # 01 == TCP_ESTABLISHED
            if state != "01":
                continue

            if inode not in socket_fds:
                continue

            local_port = endpoint_port(local_addr)
            remote_port = endpoint_port(remote_addr)

            if local_port == 4000 or remote_port == 4000:
                return socket_fds[inode]

    return None


launcher_candidates = []

for entry in os.listdir("/proc"):
    if not entry.isdigit():
        continue

    argv = process_argv(entry)

    if any(
        arg == "/launch.py" or arg.endswith("/launch.py")
        for arg in argv
    ):
        launcher_candidates.append(int(entry))

launcher_pid = None
monitor_fd = None

for candidate_pid in sorted(launcher_candidates):
    candidate_fd = process_monitor_fd(candidate_pid)

    if candidate_fd is not None:
        launcher_pid = candidate_pid
        monitor_fd = candidate_fd
        break

if launcher_pid is None or monitor_fd is None:
    candidate_text = ", ".join(
        str(pid) for pid in sorted(launcher_candidates)
    ) or "none"

    raise SystemExit(
        "vrnetlab launcher owning an established QEMU monitor "
        "connection to port 4000 was not found "
        f"(launcher candidates={candidate_text})"
    )

if not hasattr(os, "pidfd_open"):
    raise SystemExit("Python does not provide os.pidfd_open")

machine = os.uname().machine

syscall_numbers = {
    "x86_64": 438,
    "amd64": 438,
    "aarch64": 438,
    "arm64": 438,
}

sys_pidfd_getfd = syscall_numbers.get(machine)

if sys_pidfd_getfd is None:
    raise SystemExit(
        f"unsupported architecture for pidfd_getfd: {machine}"
    )

libc = ctypes.CDLL(None, use_errno=True)
pidfd = os.pidfd_open(launcher_pid)

duplicate_fd = libc.syscall(
    sys_pidfd_getfd,
    pidfd,
    monitor_fd,
    0,
)

if duplicate_fd < 0:
    err = ctypes.get_errno()
    raise OSError(err, os.strerror(err))

sock = socket.socket(fileno=duplicate_fd)
sock.setblocking(False)


def collect(timeout=0.6):
    deadline = time.monotonic() + timeout
    chunks = []

    while time.monotonic() < deadline:
        remaining = max(0.0, deadline - time.monotonic())

        readable, _, _ = select.select(
            [sock],
            [],
            [],
            min(0.1, remaining),
        )

        if not readable:
            continue

        try:
            data = sock.recv(65535)
        except BlockingIOError:
            continue

        if not data:
            break

        chunks.append(data)

    return b"".join(chunks).decode(errors="replace")


try:
    sock.sendall(b"info network\r\n")
    network_text = collect()

    device = None

    for raw_line in network_text.splitlines():
        line = raw_line.strip()

        nic_match = re.match(
            r"^(\S+):\s+index=\d+,type=nic,.*"
            r"macaddr=([0-9a-fA-F:]{17})",
            line,
        )

        if nic_match and nic_match.group(2).lower() == mac:
            device = nic_match.group(1)
            break

    if device is None:
        raise SystemExit(f"QEMU NIC with MAC {mac} was not found")

    command = f"set_link {device} {desired}\r\n".encode()
    sock.sendall(command)

    response = collect(timeout=0.4)
    lower = response.lower()

    if (
        "could not find" in lower
        or "unknown command" in lower
        or "error" in lower
    ):
        raise SystemExit(
            response.strip() or "QEMU rejected set_link"
        )

    print(device)

finally:
    try:
        sock.close()
    except Exception:
        pass

    try:
        os.close(pidfd)
    except Exception:
        pass
"""


def parse_link_endpoint(value):
    if not isinstance(value, str):
        raise LabMgmtError(f"Invalid link endpoint: {value!r}")

    if ":" not in value:
        raise LabMgmtError(
            f"Link endpoint '{value}' must use node:interface syntax"
        )

    node_name, interface_name = value.split(":", 1)

    node_name = node_name.strip()
    interface_name = interface_name.strip()

    if not node_name or not interface_name:
        raise LabMgmtError(f"Invalid link endpoint '{value}'")

    return {
        "text": f"{node_name}:{interface_name}",
        "node": node_name,
        "interface": interface_name,
    }


def load_topology_links(topology_path):
    data = load_yaml(topology_path)

    topology = data.get("topology")

    if not isinstance(topology, dict):
        raise LabMgmtError(
            f"{topology_path} does not contain a valid topology section"
        )

    raw_links = topology.get("links", [])

    if raw_links is None:
        raw_links = []

    if not isinstance(raw_links, list):
        raise LabMgmtError(
            f"{topology_path}: topology.links must be a list"
        )

    links = []

    for index, raw_link in enumerate(raw_links, start=1):
        if not isinstance(raw_link, dict):
            raise LabMgmtError(
                f"Link {index} uses an unsupported definition format; "
                "labmgmt currently requires an endpoints: list"
            )

        endpoints = raw_link.get("endpoints")

        if not isinstance(endpoints, list) or len(endpoints) != 2:
            raise LabMgmtError(
                f"Link {index} must contain exactly two endpoints"
            )

        parsed = [
            parse_link_endpoint(value)
            for value in endpoints
        ]

        links.append(
            {
                "number": index,
                "endpoints": parsed,
                "signature": "|".join(
                    sorted(endpoint["text"] for endpoint in parsed)
                ),
            }
        )

    return links


def resolve_link_selector(links, selector):
    selector_text = str(selector).strip()

    if selector_text.isdigit():
        number = int(selector_text)

        for link in links:
            if link["number"] == number:
                return link

        raise LabMgmtError(f"Link {number} does not exist")

    try:
        wanted = parse_link_endpoint(selector_text)
    except LabMgmtError:
        raise LabMgmtError(
            "Link selector must be a link number or node:interface"
        )

    wanted_node = canonical_name(wanted["node"])
    wanted_interface = wanted["interface"].strip().lower()

    matches = []

    for link in links:
        for endpoint in link["endpoints"]:
            if (
                canonical_name(endpoint["node"]) == wanted_node
                and endpoint["interface"].lower() == wanted_interface
            ):
                matches.append(link)
                break

    if not matches:
        raise LabMgmtError(
            f"Endpoint '{selector_text}' does not appear in any topology link"
        )

    if len(matches) > 1:
        numbers = ", ".join(str(link["number"]) for link in matches)

        raise LabMgmtError(
            f"Endpoint '{selector_text}' appears in multiple links: {numbers}"
        )

    return matches[0]


def containerlab_runtime(topology_path, lab_name):
    """
    Return deployed container and interface information.

    Containerlab's JSON interface inspection is used so interface aliases
    such as ge-0/0/0 are mapped to the real Linux interface automatically.
    """
    try:
        node_result = subprocess.run(
            [
                "containerlab",
                "-t",
                str(topology_path),
                "inspect",
                "-f",
                "json",
            ],
            text=True,
            capture_output=True,
            check=False,
        )
    except FileNotFoundError:
        raise LabMgmtError("containerlab command not found")

    if node_result.returncode != 0:
        return {
            "deployed": False,
            "nodes": {},
            "interfaces": {},
        }

    try:
        node_json = __import__("json").loads(node_result.stdout)
    except Exception as exc:
        raise LabMgmtError(
            f"Unable to parse Containerlab inspect JSON: {exc}"
        )

    entries = []

    if isinstance(node_json, dict):
        for value in node_json.values():
            if isinstance(value, list):
                entries.extend(value)
    elif isinstance(node_json, list):
        entries = node_json

    nodes = {}
    prefix = f"clab-{lab_name}-"

    for entry in entries:
        if not isinstance(entry, dict):
            continue

        container_name = entry.get("name")

        if not isinstance(container_name, str):
            continue

        if not container_name.startswith(prefix):
            continue

        node_name = container_name[len(prefix):]

        nodes[canonical_name(node_name)] = {
            "node": node_name,
            "container": container_name,
            "container_id": entry.get("container_id", ""),
            "kind": entry.get("kind", ""),
            "state": entry.get("state", ""),
        }

    interface_result = subprocess.run(
        [
            "containerlab",
            "-t",
            str(topology_path),
            "inspect",
            "interfaces",
            "-f",
            "json",
        ],
        text=True,
        capture_output=True,
        check=False,
    )

    interfaces = {}

    if interface_result.returncode == 0:
        try:
            interface_json = __import__("json").loads(
                interface_result.stdout
            )
        except Exception as exc:
            raise LabMgmtError(
                f"Unable to parse Containerlab interface JSON: {exc}"
            )

        if isinstance(interface_json, list):
            for item in interface_json:
                if not isinstance(item, dict):
                    continue

                container_name = item.get("name")

                if not isinstance(container_name, str):
                    continue

                records = item.get("interfaces", [])

                if isinstance(records, list):
                    interfaces[container_name] = records

    return {
        "deployed": bool(nodes),
        "nodes": nodes,
        "interfaces": interfaces,
    }


def endpoint_runtime(runtime, endpoint):
    node_key = canonical_name(endpoint["node"])
    node_runtime = runtime["nodes"].get(node_key)

    if node_runtime is None:
        raise LabMgmtError(
            f"Node '{endpoint['node']}' is not deployed"
        )

    container_name = node_runtime["container"]
    records = runtime["interfaces"].get(container_name, [])
    wanted = endpoint["interface"].lower()
    matches = []

    for record in records:
        if not isinstance(record, dict):
            continue

        raw_name = str(record.get("name", ""))
        alias = str(record.get("alias", ""))

        if raw_name.lower() == wanted or alias.lower() == wanted:
            matches.append(record)

    if not matches:
        raise LabMgmtError(
            f"Unable to map {endpoint['text']} to an interface "
            f"inside {container_name}"
        )

    if len(matches) > 1:
        raise LabMgmtError(
            f"Interface mapping for {endpoint['text']} is ambiguous"
        )

    record = matches[0]

    return {
        **node_runtime,
        "endpoint": endpoint["text"],
        "raw_interface": record.get("name", ""),
        "alias": record.get("alias", ""),
        "mac": str(record.get("mac", "")).lower(),
        "interface_state": str(record.get("state", "")).lower(),
    }


def endpoint_uses_qemu(endpoint_info):
    result = subprocess.run(
        [
            "docker",
            "exec",
            endpoint_info["container"],
            "sh",
            "-c",
            "test -e /launch.py && pgrep -f '/launch.py' >/dev/null",
        ],
        text=True,
        capture_output=True,
        check=False,
    )

    return result.returncode == 0


def qemu_set_link(endpoint_info, desired):
    mac = endpoint_info.get("mac", "")

    if not re.fullmatch(
        r"[0-9a-f]{2}(?::[0-9a-f]{2}){5}",
        mac,
    ):
        raise LabMgmtError(
            f"Cannot determine QEMU NIC for {endpoint_info['endpoint']}: "
            "interface MAC is unavailable"
        )

    desired_qemu = "off" if desired == "down" else "on"

    result = subprocess.run(
        [
            "docker",
            "exec",
            "-i",
            endpoint_info["container"],
            "python3",
            "-c",
            QEMU_LINK_HELPER,
            mac,
            desired_qemu,
        ],
        text=True,
        capture_output=True,
        check=False,
    )

    if result.returncode != 0:
        detail = (
            result.stderr.strip()
            or result.stdout.strip()
            or "no diagnostic output"
        )

        raise LabMgmtError(
            f"Unable to set {endpoint_info['endpoint']} "
            f"{desired}: {detail}"
        )

    device_lines = result.stdout.strip().splitlines()

    return device_lines[-1] if device_lines else "QEMU NIC"


def native_set_link(endpoint_info, desired):
    result = subprocess.run(
        [
            "docker",
            "exec",
            endpoint_info["container"],
            "ip",
            "link",
            "set",
            "dev",
            endpoint_info["raw_interface"],
            desired,
        ],
        text=True,
        capture_output=True,
        check=False,
    )

    if result.returncode != 0:
        detail = (
            result.stderr.strip()
            or result.stdout.strip()
            or "no diagnostic output"
        )

        raise LabMgmtError(
            f"Unable to set {endpoint_info['endpoint']} "
            f"{desired}: {detail}"
        )

    return endpoint_info["raw_interface"]


def link_state_path(lab_name):
    return (
        LABMGMT_LINK_STATE_DIR
        / f"{canonical_name(lab_name)}.json"
    )


def load_link_state(lab_name):
    path = link_state_path(lab_name)

    if not path.exists():
        return {"version": 1, "links": {}}

    try:
        with path.open("r", encoding="utf-8") as handle:
            data = __import__("json").load(handle)
    except Exception:
        return {"version": 1, "links": {}}

    if not isinstance(data, dict):
        return {"version": 1, "links": {}}

    if not isinstance(data.get("links"), dict):
        data["links"] = {}

    return data


def save_link_state(lab_name, state):
    LABMGMT_LINK_STATE_DIR.mkdir(
        parents=True,
        exist_ok=True,
    )

    path = link_state_path(lab_name)
    temp_path = path.with_name(
        f".{path.name}.tmp-{os.getpid()}"
    )

    with temp_path.open("w", encoding="utf-8") as handle:
        __import__("json").dump(
            state,
            handle,
            indent=2,
            sort_keys=True,
        )
        handle.write("\n")
        handle.flush()
        os.fsync(handle.fileno())

    os.replace(temp_path, path)


def runtime_container_ids(endpoint_infos):
    return {
        info["endpoint"]: info.get("container_id", "")
        for info in endpoint_infos
    }


def valid_recorded_down(record, endpoint_infos):
    if not isinstance(record, dict):
        return False

    if record.get("state") != "down":
        return False

    recorded_ids = record.get("container_ids", {})

    if not isinstance(recorded_ids, dict):
        return False

    current_ids = runtime_container_ids(endpoint_infos)

    return (
        recorded_ids == current_ids
        and all(current_ids.values())
    )


def link_runtime_state(link, runtime, lab_name):
    if not runtime["deployed"]:
        return "not-deployed"

    endpoint_infos = []

    try:
        for endpoint in link["endpoints"]:
            endpoint_infos.append(
                endpoint_runtime(runtime, endpoint)
            )
    except LabMgmtError:
        return "partial"

    state = load_link_state(lab_name)
    record = state["links"].get(link["signature"])

    if valid_recorded_down(record, endpoint_infos):
        return "down"

    if any(
        info.get("interface_state", "") == "down"
        for info in endpoint_infos
    ):
        return "down"

    return "up"


def prepare_link_operation(topology_path, link):
    topo = parse_topology(topology_path)

    runtime = containerlab_runtime(
        topology_path,
        topo["name"],
    )

    if not runtime["deployed"]:
        raise LabMgmtError(
            f"Lab '{topo['name']}' is not deployed"
        )

    endpoint_infos = []

    for endpoint in link["endpoints"]:
        info = endpoint_runtime(runtime, endpoint)

        info["backend"] = (
            "qemu"
            if endpoint_uses_qemu(info)
            else "native"
        )

        endpoint_infos.append(info)

    return topo, runtime, endpoint_infos


def set_link_state(topology_path, link, desired):
    if desired not in ("up", "down"):
        raise LabMgmtError(f"Invalid link state '{desired}'")

    topo, runtime, endpoint_infos = prepare_link_operation(
        topology_path,
        link,
    )

    changed = []

    try:
        for info in endpoint_infos:
            if info["backend"] == "qemu":
                target = qemu_set_link(info, desired)
            else:
                target = native_set_link(info, desired)

            changed.append((info, target))

    except Exception:
        if desired == "down":
            for info, _ in reversed(changed):
                try:
                    if info["backend"] == "qemu":
                        qemu_set_link(info, "up")
                    else:
                        native_set_link(info, "up")
                except Exception:
                    pass

        raise

    state = load_link_state(topo["name"])

    if desired == "down":
        state["links"][link["signature"]] = {
            "state": "down",
            "link_number": link["number"],
            "endpoints": [
                endpoint["text"]
                for endpoint in link["endpoints"]
            ],
            "container_ids": runtime_container_ids(endpoint_infos),
        }
    else:
        state["links"].pop(link["signature"], None)

    save_link_state(topo["name"], state)

    return topo, changed


def print_link_action(link, topo, changed, desired):
    print()
    print(f"Link {link['number']} {desired.upper()}")

    for info, target in changed:
        print(
            f"  {info['endpoint']:<30} "
            f"{info['backend']:<6} "
            f"{target}"
        )

    print()
    print(f"Lab: {topo['name']}")


def command_links(args):
    topology_path = resolve_topology_path(args.topology)
    topo = parse_topology(topology_path)
    links = load_topology_links(topology_path)

    runtime = containerlab_runtime(
        topology_path,
        topo["name"],
    )

    rows = []

    for link in links:
        rows.append(
            (
                str(link["number"]),
                link["endpoints"][0]["text"],
                link["endpoints"][1]["text"],
                link_runtime_state(
                    link,
                    runtime,
                    topo["name"],
                ),
            )
        )

    print()
    print(f"Lab: {topo['name']}")
    print(f"Topology: {repo_relative(topology_path)}")
    print()

    if not rows:
        print("No topology links are defined.")
        return

    headers = (
        "LINK",
        "ENDPOINT-A",
        "ENDPOINT-B",
        "STATE",
    )

    widths = [
        len(value)
        for value in headers
    ]

    for row in rows:
        for index, value in enumerate(row):
            widths[index] = max(
                widths[index],
                len(str(value)),
            )

    def render(row):
        return "  ".join(
            str(value).ljust(widths[index])
            for index, value in enumerate(row)
        )

    print(render(headers))
    print(
        render(
            tuple("-" * width for width in widths)
        )
    )

    for row in rows:
        print(render(row))

    print()
    print(
        "Link numbers reflect the current topology order and "
        "may change after topology edits."
    )


def command_link_down(args):
    topology_path = resolve_topology_path(args.topology)
    links = load_topology_links(topology_path)
    link = resolve_link_selector(links, args.link)

    topo, changed = set_link_state(
        topology_path,
        link,
        "down",
    )

    print_link_action(
        link,
        topo,
        changed,
        "down",
    )


def command_link_up(args):
    topology_path = resolve_topology_path(args.topology)
    links = load_topology_links(topology_path)
    link = resolve_link_selector(links, args.link)

    topo, changed = set_link_state(
        topology_path,
        link,
        "up",
    )

    print_link_action(
        link,
        topo,
        changed,
        "up",
    )


def command_link_flap(args):
    topology_path = resolve_topology_path(args.topology)
    links = load_topology_links(topology_path)
    link = resolve_link_selector(links, args.link)

    seconds = float(args.seconds)

    if seconds <= 0:
        raise LabMgmtError(
            "Flap duration must be greater than zero"
        )

    down_succeeded = False

    try:
        topo, changed = set_link_state(
            topology_path,
            link,
            "down",
        )

        down_succeeded = True

        print_link_action(
            link,
            topo,
            changed,
            "down",
        )

        print()
        print(f"Waiting {seconds:g} second(s)...")

        time.sleep(seconds)

    finally:
        if down_succeeded:
            topo, changed = set_link_state(
                topology_path,
                link,
                "up",
            )

            print_link_action(
                link,
                topo,
                changed,
                "up",
            )


def main():
    parser = argparse.ArgumentParser(
        prog="labmgmt",
        description="Containerlab management-network IPAM tool",
    )

