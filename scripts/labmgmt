    link_up_parser.add_argument(
        "link",
        help="Link number or node:interface",
    )

    link_up_parser.set_defaults(
        func=command_link_up
    )

    link_flap_parser = subparsers.add_parser(
        "link-flap",
        help="Take a link down temporarily and restore it",
    )

    link_flap_parser.add_argument(
        "topology",
        help="Lab name or Containerlab topology file",
