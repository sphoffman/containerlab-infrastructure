            "is skipped"
        ),
    )

    save_parser.set_defaults(
        func=command_save
    )

    restore_parser = subparsers.add_parser(
        "restore",
        help=(
            "Restore Junos named configuration files "
            "after nodes are deployed"
        ),
    )

    restore_parser.add_argument(
        "topology",
